@model WEBPC_KHACHHANG.Models.ViewModels.LichSuDonHangViewModel

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaCodeDonHang;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. Logic Trạng thái đơn hàng (Đồng bộ với Index)
    string statusClass = "wait";
    string statusLabel = Model.TrangThai;
    switch (Model.TrangThai)
    {
        case "ChoXacNhan": statusClass = "wait"; statusLabel = "CHỜ XÁC NHẬN"; break;
        case "ChoThanhToan": statusClass = "wait"; statusLabel = "CHỜ THANH TOÁN"; break;
        case "DaThanhToan": statusClass = "wait"; statusLabel = "ĐÃ THANH TOÁN"; break;
        case "DangGiao": statusClass = "shipping"; statusLabel = "ĐANG VẬN CHUYỂN"; break;
        case "DaGiao": statusClass = "done"; statusLabel = "HOÀN THÀNH"; break;
        case "Huy": statusClass = "cancel"; statusLabel = "ĐÃ HỦY"; break;
    }

    // 2. Logic Stepper (Thanh tiến trình)
    int stepStatus = 0;
    if (Model.TrangThai == "Huy") { stepStatus = -1; }
    else if (Model.TrangThai == "DaGiao") { stepStatus = 2; }
    else if (Model.TrangThai == "DangGiao") { stepStatus = 1; }
    else { stepStatus = 0; } // Các trạng thái chờ còn lại
}

@section Styles {
    <link href="~/Content/css/order-detail.css" rel="stylesheet" />
}

<div class="order-detail-container">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <a href="@Url.Action("Index", "DonHang")" class="back-link">
                    <i class="bi bi-arrow-left"></i> QUAY LẠI DANH SÁCH
                </a>
                <h3 class="fw-bold mb-0 text-uppercase">
                    Đơn hàng <span class="text-primary">#@Model.MaCodeDonHang</span>
                </h3>
                <span class="text-muted small">Ngày đặt: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <div class="mt-3 mt-md-0">
                <span class="status-tag @statusClass">@statusLabel</span>
            </div>
        </div>

        @if (stepStatus != -1)
        {
            <div class="tracking-wrapper">
                <ul class="step-wizard-list">
                    <li class="step-wizard-item @(stepStatus >= 0 ? "active" : "")">
                        <span class="progress-count">1</span>
                        <span class="progress-label">Đang xử lý</span>
                    </li>
                    <li class="step-wizard-item @(stepStatus >= 1 ? "active" : "")">
                        <span class="progress-count">2</span>
                        <span class="progress-label">Đang vận chuyển</span>
                    </li>
                    <li class="step-wizard-item @(stepStatus >= 2 ? "active" : "")">
                        <span class="progress-count">3</span>
                        <span class="progress-label">Giao thành công</span>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-danger text-center fw-bold text-uppercase mb-4">
                <i class="bi bi-x-octagon-fill me-2"></i> Đơn hàng này đã bị hủy
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="tech-card">
                    <div class="tech-header">
                        <h5><i class="bi bi-bag-check-fill"></i> Danh sách linh kiện</h5>
                    </div>
                    <div class="tech-body">
                        @foreach (var item in Model.ChiTiet)
                        {
                            <div class="prod-item">
                                <div class="prod-img-box">
                                    <img src="@item.HinhAnh" alt="@item.TenSanPham" onerror="this.src='/Content/images/no-image.png'" />
                                </div>
                                <div class="prod-info-box">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })" class="prod-title">
                                                @item.TenSanPham
                                            </a>
                                            <span class="prod-qty">Số lượng: x @item.SoLuong</span>
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <span class="prod-final-price">@item.ThanhTien.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="tech-card">
                    <div class="tech-header">
                        <h5><i class="bi bi-geo-alt-fill"></i> Địa chỉ nhận hàng</h5>
                    </div>
                    <div class="tech-body">
                        <div class="info-group">
                            <span class="info-label">Người nhận</span>
                            <div class="info-value"><i class="bi bi-person-fill"></i> @Model.NguoiNhan</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Số điện thoại</span>
                            <div class="info-value"><i class="bi bi-telephone-fill"></i> @Model.SoDienThoaiGiao</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Địa chỉ</span>
                            <div class="info-value"><i class="bi bi-map-fill"></i> @Model.DiaChiGiaoHang</div>
                        </div>
                    </div>
                </div>

                <div class="tech-card">
                    <div class="tech-header">
                        <h5><i class="bi bi-credit-card-2-front-fill"></i> Thanh toán</h5>
                    </div>
                    <div class="tech-body pt-3">
                        <div class="info-group">
                            <span class="info-label">Phương thức</span>
                            <div class="info-value mb-3">
                                @if (Model.PhuongThucThanhToan == "COD")
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-cash"></i> Tiền mặt (COD)</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary"><i class="bi bi-qr-code"></i> Chuyển khoản (VietQR)</span>
                                }
                            </div>

                            @{
                                string payLabel = "Chưa thanh toán";
                                string payClass = "danger"; // danger/success/warning
                                bool isPaid = false;

                                if (Model.PhuongThucThanhToan == "COD")
                                {
                                    // COD: Chỉ khi Giao thành công hoặc Đã thanh toán mới tính là Paid
                                    if (Model.TrangThai == "DaGiao" || Model.TrangThai == "DaThanhToan")
                                    {
                                        payLabel = "Đã thanh toán";
                                        payClass = "success";
                                        isPaid = true;
                                    }
                                    else if (Model.TrangThai == "Huy")
                                    {
                                        payLabel = "Thanh toán thất bại";
                                        payClass = "danger";
                                    }
                                    else
                                    {
                                        payLabel = "Thanh toán khi nhận";
                                        payClass = "warning";
                                    }

                                }
                                else // VietQR
                                {
                                    // Kiểm tra giao dịch có trạng thái 'Success' (khớp với Entity GiaoDichThanhToan)
                                    var lastTx = Model.GiaoDichs?.OrderByDescending(x => x.NgayGiaoDich).FirstOrDefault();
                                    if (lastTx != null && lastTx.TrangThai == "Success")
                                    {
                                        payLabel = "Đã thanh toán";
                                        payClass = "success";
                                        isPaid = true;
                                    }
                                    else if (lastTx != null && lastTx.TrangThai == "Failed")
                                    {
                                        payLabel = "Thanh toán thì thất bại";
                                        payClass = "danger";
                                    }
                                    else
                                    {
                                        payLabel = "Chờ thanh toán";
                                        payClass = "danger";
                                    }
                                }
                            }

                            <div class="alert alert-@payClass d-flex align-items-center p-2" role="alert">
                                @if (isPaid)
                                {
                                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                }
                                else if (payClass == "warning")
                                {
                                    <i class="bi bi-hourglass-split me-2 fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                }
                                <div>
                                    <small class="text-uppercase fw-bold" style="font-size: 0.7rem;">Trạng thái thanh toán</small><br />
                                    <span class="fw-bold">@payLabel</span>
                                </div>
                            </div>
                        </div>

                        <div class="invoice-box">
                            <div class="invoice-row">
                                <span>Tạm tính</span>
                                <span>@((Model.TongTien - Model.PhiVanChuyen).ToString("N0")) đ</span>
                            </div>
                            <div class="invoice-row">
                                <span>Phí vận chuyển</span>
                                <span>@Model.PhiVanChuyen.ToString("N0") đ</span>
                            </div>
                            <div class="invoice-row total">
                                <span class="total-title">Tổng cộng</span>
                                <span class="total-num">@Model.TongTien.ToString("N0")<small>đ</small></span>
                            </div>

                            @if (Model.PhuongThucThanhToan == "VietQR" && !isPaid && Model.TrangThai != "Huy" && Model.TrangThai != "DaGiao")
                            {
                                <a href="@Url.Action("Payment", "ThanhToan", new { orderId = Model.MaDonHang })" class="btn btn-primary w-100 mt-3 fw-bold">
                                    THANH TOÁN NGAY
                                </a>
                            }

                            @if (Model.TrangThai == "ChoXacNhan" || Model.TrangThai == "ChoThanhToan")
                            {
                                <a href="javascript:void(0);" onclick="alert('Tính năng hủy đang phát triển!')" class="btn-cancel">
                                    <i class="bi bi-x-lg"></i> Hủy Đơn Hàng
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>