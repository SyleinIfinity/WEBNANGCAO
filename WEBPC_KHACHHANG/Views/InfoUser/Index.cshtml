@model WEBPC_KHACHHANG.Models.ViewModels.InfoUserViewModel

@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/infouser.css" rel="stylesheet" />
}

<section class="py-5 bg-light min-vh-100">
    <div class="container">
        <h2 class="mb-4 fw-bold">Tài Khoản Của Tôi</h2>
        <div class="row g-4">

            <div class="col-lg-3">
                <div class="card p-3 shadow-sm">
                    <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                        <img src="@(string.IsNullOrEmpty(Model?.AvatarUrl) ? "https://via.placeholder.com/60" : Model.AvatarUrl)" class="rounded-circle me-3 border" alt="Avatar" style="width:60px; height:60px; object-fit:cover;">
                        <div class="overflow-hidden">
                            <p class="mb-0 fw-bold">Xin chào,</p>
                            <p class="mb-0 text-primary fw-semibold text-truncate">@Model.HoTen</p>
                        </div>
                    </div>
                    <ul class="nav nav-pills flex-column user-dashboard-nav">
                        <li class="nav-item">
                            <a class="nav-link active-info" href="@Url.Action("Index", "InfoUser")">
                                <i class="bi bi-person-circle me-2"></i>Thông tin cá nhân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-card-checklist me-2"></i>Lịch sử đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "InfoAddress")">
                                <i class="bi bi-geo-alt me-2"></i>Sổ địa chỉ
                            </a>
                        </li>
                        <li class="nav-item mt-3">
                            <a class="nav-link text-danger" href="@Url.Action("Logout", "Login")">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card p-4 shadow-sm">
                    <h4 class="mb-4 fw-bold border-bottom pb-2">Cập nhật thông tin cá nhân</h4>

                    <form>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Họ và Tên</label>
                                <input type="text" class="form-control form-control-lg" value="@Model.HoTen" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" class="form-control form-control-lg" value="@Model.Email" disabled>
                                <div class="form-text">Không thể thay đổi địa chỉ email.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại</label>
                                <input type="tel" class="form-control form-control-lg" value="@Model.SoDienThoai" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ngày sinh</label>
                                <input type="text" class="form-control form-control-lg"
                                       value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")" readonly>
                            </div>

                            <div class="col-12 mt-4">
                                <label class="form-label fw-semibold">Giới tính</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="gender" disabled @(Model.GioiTinh == "Nam" ? "checked" : "")>
                                        <label class="form-check-label">Nam</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="gender" disabled @(Model.GioiTinh == "Nu" || Model.GioiTinh == "Nữ" ? "checked" : "")>
                                        <label class="form-check-label">Nữ</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="button" class="btn btn-secondary btn-lg mt-3" disabled>Tính năng cập nhật đang bảo trì</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>