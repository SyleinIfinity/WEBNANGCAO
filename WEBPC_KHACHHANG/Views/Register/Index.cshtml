@model WEBPC_KHACHHANG.Models.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .register-box {
        max-width: 500px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
    }

    .register-title {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
        font-weight: bold;
    }

    .form-control {
        height: 45px;
    }

    .btn-register {
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
    }
</style>

<div class="register-box">
    <h2 class="register-title">Đăng ký thành viên</h2>
    <hr />

    @* Hiển thị thông báo lỗi chung nếu có *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false, "", new { @class = "text-danger", style = "list-style:none; padding-left:0" })
        </div>
    }

    @using (Html.BeginForm("Index", "Register", FormMethod.Post, new { @id = "formRegister" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.HoTen, "Họ và tên")
            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ và tên của bạn" })
            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.SoDienThoai, "Số điện thoại")
            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
            @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email")
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "email@example.com" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.TenDangNhap, "Tên đăng nhập")
            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Tên đăng nhập" })
            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MatKhau, "Mật khẩu")
            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhập mật khẩu" })
            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.XacNhanMatKhau, "Xác nhận mật khẩu")
            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
            @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
        </div>

        <br />

        <div class="form-group">
            <button type="submit" class="btn btn-primary btn-block btn-register" style="width:100%">
                Đăng Ký
            </button>
        </div>

        <div class="text-center mt-3">
            <p>Đã có tài khoản? <a href="@Url.Action("Index", "Login")" class="text-primary">Đăng nhập ngay</a></p>
        </div>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}