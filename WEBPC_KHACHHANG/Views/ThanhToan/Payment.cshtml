@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orderId = ViewBag.OrderId ?? "N/A";
    var orderCode = ViewBag.OrderCode ?? "";
    var totalAmount = ViewBag.TotalAmount ?? "";
    var qrImage = ViewBag.QrImage;
    var error = ViewBag.Error;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 font-weight-bold">Thanh toán qua VietQR</h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3 text-center">
                        <span class="badge bg-info text-dark px-3 py-2 fs-6">Đơn hàng #@@orderCode</span>
                    </div>
                    <div class="mb-3 text-center">
                        <span class="fs-5 fw-bold text-danger">
                            Tổng tiền:
                            @if (!string.IsNullOrEmpty(totalAmount.ToString()))
                            {
                                @($"{((decimal)totalAmount):N0}₫")
                            }
                        </span>
                    </div>
                    <div class="mb-4 text-center">
                        <span class="text-muted">
                            Vui lòng sử dụng ứng dụng ngân hàng hoặc ví điện tử hỗ trợ QR để quét mã dưới đây và hoàn tất thanh toán.
                        </span>
                    </div>
                    <div class="qr-container my-4 text-center">
                        @if (qrImage != null)
                        {
                            <img src="@qrImage" class="img-fluid border border-2 p-2 rounded bg-white" alt="Mã QR Thanh Toán" style="max-width: 320px;" />
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                Không thể tải mã QR. @error
                            </div>
                        }
                    </div>
                    <div class="mb-3 text-center">
                        <span class="text-primary fw-bold animate-pulse">
                            Đang chờ thanh toán...
                        </span>
                        <div class="spinner-border text-primary ms-2" role="status" style="width: 1.5rem; height: 1.5rem;">
                            <span class="visually-hidden">Đang xử lý...</span>
                        </div>
                    </div>
                    <div class="alert alert-warning small text-center">
                        <i class="fa fa-info-circle"></i>
                        Không chỉnh sửa nội dung chuyển khoản để hệ thống tự động xác nhận đơn hàng.
                    </div>
                </div>
                <div class="card-footer bg-light text-center p-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="fa fa-arrow-left"></i> Về trang chủ
                    </a>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-shopping-cart"></i> Xem giỏ hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-pulse {
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            opacity: 0.6;
        }

        50% {
            opacity: 1;
        }

        100% {
            opacity: 0.6;
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            var orderId = '@orderId';
            var intervalTime = 3000;
            var isPaid = false;

            function checkPaymentStatus() {
                if (isPaid) return;
                $.ajax({
                    url: '/ThanhToan/CheckStatus',
                    type: 'GET',
                    data: { id: orderId },
                    success: function (res) {
                        try {
                            var data = typeof res === 'string' ? JSON.parse(res) : res;
                            if (data.status === "PAID") {
                                isPaid = true;
                                clearInterval(checkInterval);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thanh toán thành công!',
                                    text: 'Đơn hàng của bạn đã được xác nhận.',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.href = "/ThanhToan/Success";
                                });
                            }
                        } catch (e) { }
                    }
                });
            }
            if (orderId && orderId !== '0') {
                var checkInterval = setInterval(checkPaymentStatus, intervalTime);
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
