@model WEBPC_KHACHHANG.Models.ViewModels.CartViewModel
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .cart-item-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
    }

    .cart-summary-card {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 1.5rem;
    }

        .cart-summary-card h4 {
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

    /* Hiệu ứng cho nút cập nhật */
    .btn-confirm-update {
        transition: all 0.3s ease;
    }
</style>

<section class="py-5">
    <div class="container">
        <h1 class="section-title mb-5 text-center">Giỏ Hàng Của Bạn</h1>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-warning text-center">@TempData["Message"]</div>
        }

        <div class="row">
            <div class="col-lg-8 mb-4 mb-lg-0">
                <div class="card p-4 shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table cart-table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 50px;" class="text-center">
                                        <input class="form-check-input" type="checkbox" id="selectAll">
                                    </th>
                                    <th scope="col">Sản Phẩm</th>
                                    <th scope="col" class="text-center">Giá</th>
                                    <th scope="col" class="text-center" style="width: 150px;">Số Lượng</th>
                                    <th scope="col" class="text-center">Tổng</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody id="cart-body">
                                @if (Model != null && Model.Items != null && Model.Items.Count > 0)
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr class="cart-item" data-price="@item.Price" data-id="@item.ProductId">
                                            <td class="text-center">
                                                <input class="form-check-input item-checkbox" type="checkbox">
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <a href="/Product/Detail/@item.ProductId">
                                                        <img src="@item.ProductImage" class="cart-item-img me-3" alt="@item.ProductName" onerror="this.src='https://via.placeholder.com/80'">
                                                    </a>
                                                    <div>
                                                        <a href="/Product/Detail/@item.ProductId" class="text-decoration-none text-dark">
                                                            <h6 class="mb-0 fw-bold">@item.ProductName</h6>
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold price-display">
                                                @item.Price.ToString("N0")₫
                                            </td>

                                            <td class="text-center">
                                                <div class="input-group input-group-sm justify-content-center">
                                                    <input type="number"
                                                           class="form-control text-center quantity-input"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           data-original="@item.Quantity"
                                                           oninput="checkQuantityChange(this)"
                                                           style="max-width: 70px;">

                                                    <button class="btn btn-success btn-confirm-update d-none"
                                                            type="button"
                                                            title="Xác nhận thay đổi"
                                                            onclick="confirmUpdateQuantity(@item.ProductId, this)">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </div>
                                            </td>

                                            <td class="text-center text-primary fw-bold total-line-price">
                                                @item.Total.ToString("N0")₫
                                            </td>
                                            <td>
                                                <button class="btn btn-outline-danger btn-sm" onclick="removeItem(@item.ProductId)">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <i class="bi bi-cart-x display-4 text-muted"></i>
                                            <p class="mt-3">Giỏ hàng trống</p>
                                            <a href="/" class="btn btn-primary">Mua sắm ngay</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary-card">
                    <h4 class="fw-bold">Tổng Kết</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Đã chọn:</span>
                        <span class="fw-semibold" id="summary-count">0 sản phẩm</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Tạm tính:</span>
                        <span class="fw-semibold" id="summary-subtotal">0₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 pt-3 border-top">
                        <h5 class="fw-bold">Thành tiền:</h5>
                        <h5 class="fw-bold text-primary" id="summary-total">0₫</h5>
                    </div>

                    <button id="btn-checkout" class="btn btn-primary btn-lg w-100 fw-bold" disabled>
                        TIẾN HÀNH THANH TOÁN
                    </button>

                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary btn-lg w-100 mt-3 fw-bold">
                        TIẾP TỤC MUA SẮM
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- 1. KHAI BÁO BIẾN ---
            const selectAllCheckbox = document.getElementById('selectAll');
            const checkoutBtn = document.getElementById('btn-checkout');

            // Hàm định dạng tiền VNĐ
            const formatCurrency = (amount) => {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            };

            // --- 2. HÀM TÍNH TOÁN TỔNG TIỀN (FRONTEND) ---
            window.updateCartSummary = function () {
                let totalAmount = 0;
                let totalCount = 0;
                let allChecked = true;
                let hasItem = false;

                const rows = document.querySelectorAll('.cart-item');
                if (rows.length === 0) allChecked = false;

                rows.forEach(row => {
                    hasItem = true;
                    const checkbox = row.querySelector('.item-checkbox');
                    const quantityInput = row.querySelector('.quantity-input');
                    const priceRaw = parseFloat(row.getAttribute('data-price'));

                    // Lấy số lượng từ input (nếu đang sửa thì lấy số mới để tính tạm, hoặc lấy số gốc nếu muốn chặt chẽ)
                    // Ở đây ta lấy số hiện tại trong ô input để người dùng thấy giá thay đổi realtime
                    const quantity = parseInt(quantityInput.value) || 0;

                    // Tính tiền từng dòng
                    const lineTotal = priceRaw * quantity;
                    row.querySelector('.total-line-price').textContent = formatCurrency(lineTotal);

                    // Chỉ cộng vào tổng nếu được Check
                    if (checkbox.checked) {
                        totalAmount += lineTotal;
                        totalCount += quantity;
                    } else {
                        allChecked = false;
                    }
                });

                // Cập nhật giao diện Summary
                document.getElementById('summary-subtotal').textContent = formatCurrency(totalAmount);
                document.getElementById('summary-total').textContent = formatCurrency(totalAmount);
                document.getElementById('summary-count').textContent = totalCount + ' sản phẩm';

                // Checkbox selectAll
                if (selectAllCheckbox) selectAllCheckbox.checked = allChecked && hasItem;

                // Nút thanh toán
                if (totalCount > 0) {
                    checkoutBtn.removeAttribute('disabled');
                } else {
                    checkoutBtn.setAttribute('disabled', 'true');
                }
            };

            // --- 3. SỰ KIỆN ---

            // Nút chọn tất cả
            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    document.querySelectorAll('.item-checkbox').forEach(cb => {
                        cb.checked = isChecked;
                    });
                    updateCartSummary();
                });
            }

            // Sự kiện check từng món
            const cartBody = document.getElementById('cart-body');
            if (cartBody) {
                cartBody.addEventListener('change', function (e) {
                    if (e.target.classList.contains('item-checkbox')) {
                        updateCartSummary();
                    }
                });
            }

            // Sự kiện nút Thanh toán
            if (checkoutBtn) {
                checkoutBtn.addEventListener('click', function () {
                    const selectedIds = [];
                    const rows = document.querySelectorAll('.cart-item');

                    rows.forEach(row => {
                        const checkbox = row.querySelector('.item-checkbox');
                        if (checkbox && checkbox.checked) {
                            const id = row.getAttribute('data-id');
                            if(id) selectedIds.push(id);
                        }
                    });

                    if (selectedIds.length === 0) {
                        alert("Vui lòng chọn ít nhất một sản phẩm để thanh toán!");
                        return;
                    }

                    window.location.href = '@Url.Action("Checkout", "ThanhToan")?selectedIds=' + selectedIds.join(',');
                });
            }

            // Gọi lần đầu
            updateCartSummary();
        });

        // --- 4. LOGIC XỬ LÝ SỐ LƯỢNG MỚI ---

        // Hàm kiểm tra khi gõ phím: Nếu khác số gốc -> Hiện nút check
        function checkQuantityChange(input) {
            let currentVal = parseInt(input.value);
            let originalVal = parseInt(input.getAttribute('data-original'));

            // Tìm nút button kế bên input
            let btn = input.nextElementSibling;

            if (!isNaN(currentVal) && currentVal > 0 && currentVal !== originalVal) {
                // Nếu khác số gốc: Hiện nút
                btn.classList.remove('d-none');
            } else {
                // Nếu giống số gốc hoặc không hợp lệ: Ẩn nút
                btn.classList.add('d-none');
            }

            // Cập nhật tạm thời tổng tiền hiển thị (Optional)
            if(window.updateCartSummary) window.updateCartSummary();
        }

        // Hàm xác nhận cập nhật (Ajax)
        function confirmUpdateQuantity(productId, btnElement) {
            const inputGroup = btnElement.closest('.input-group');
            const inputElement = inputGroup.querySelector('.quantity-input');
            const quantity = parseInt(inputElement.value);

            if (quantity < 1 || isNaN(quantity)) {
                alert("Số lượng không hợp lệ!");
                inputElement.value = inputElement.getAttribute('data-original');
                checkQuantityChange(inputElement);
                return;
            }

            // Hiệu ứng loading
            const originalIcon = btnElement.innerHTML;
            btnElement.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            btnElement.disabled = true;

            // Gửi Ajax
            var formData = 'productId=' + encodeURIComponent(productId) +
                           '&quantity=' + encodeURIComponent(quantity);

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                // Xử lý trường hợp chưa đăng nhập
                if (data.requireLogin) {
                    alert(data.message);
                    // Chuyển hướng về trang Login, kèm ReturnUrl là trang hiện tại
                    window.location.href = '/Login?returnUrl=/Cart';
                    return;
                }

                if (data.success) {
                    // Cập nhật thành công
                    // 1. Cập nhật data-original mới
                    inputElement.setAttribute('data-original', quantity);
                    // 2. Ẩn nút check đi
                    btnElement.classList.add('d-none');
                    // 3. Tính lại tổng tiền
                    if(window.updateCartSummary) window.updateCartSummary();
                    // 4. Thông báo nhẹ (hoặc không cần alert để trải nghiệm mượt hơn)
                    // console.log("Updated");
                } else {
                    alert("Lỗi: " + data.message);
                    // Reset về số cũ
                    inputElement.value = inputElement.getAttribute('data-original');
                    checkQuantityChange(inputElement);
                }
            })
            .catch(error => {
                console.error(error);
                alert("Lỗi kết nối server.");
            })
            .finally(() => {
                // Trả lại trạng thái nút
                btnElement.innerHTML = originalIcon;
                btnElement.disabled = false;
            });
        }

        // Hàm xóa
        function removeItem(id) {
            if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                window.location.href = '/Cart/Remove/' + id;
            }
        }
    </script>
}