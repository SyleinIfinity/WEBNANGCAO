@model WEBPC_KHACHHANG.Models.ViewModels.CartViewModel
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .cart-item-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
    }

    .cart-table th, .cart-table td {
        vertical-align: middle;
    }

    .cart-summary-card {
        background: #f8f9fa; /* var(--light-bg) */
        border-radius: 15px;
        padding: 1.5rem;
    }

        .cart-summary-card h4 {
            font-weight: 700;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

    /* Ẩn các style xung đột nếu cần */
    .quantity-input {
        max-width: 70px;
    }
</style>

<section class="py-5">
    <div class="container">
        <h1 class="section-title mb-5 text-center">Giỏ Hàng Của Bạn</h1>

        <div class="row">
            <div class="col-lg-8 mb-4 mb-lg-0">
                <div class="card p-4 shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table cart-table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 50px;" class="text-center">
                                        <input class="form-check-input" type="checkbox" id="selectAll">
                                    </th>
                                    <th scope="col">Sản Phẩm</th>
                                    <th scope="col" class="text-center">Giá</th>
                                    <th scope="col" class="text-center">Số Lượng</th>
                                    <th scope="col" class="text-center">Tổng Cộng</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody id="cart-body">
                                @if (Model.Items != null && Model.Items.Count > 0)
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr class="cart-item" data-price="@item.Price" data-id="@item.ProductId">
                                            <td class="text-center">
                                                <input class="form-check-input item-checkbox" type="checkbox">
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <a href="/Product/Detail/@item.ProductId">
                                                        <img src="@item.ProductImage" class="cart-item-img me-3" alt="@item.ProductName" onerror="this.src='https://via.placeholder.com/80'">
                                                    </a>
                                                    <div>
                                                        <a href="/Product/Detail/@item.ProductId" class="text-decoration-none text-dark">
                                                            <h6 class="mb-0 fw-bold">@item.ProductName</h6>
                                                        </a>
                                                        @* <small class="text-muted">Danh mục/Loại</small> *@
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold price-display">
                                                @item.Price.ToString("N0")₫
                                            </td>
                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm text-center mx-auto quantity-input"
                                                       value="@item.Quantity"
                                                       min="1"
                                                       onchange="handleQuantityChange(this, @item.ProductId)">
                                            </td>
                                            <td class="text-center text-primary fw-bold total-line-price">
                                                @((item.Price * item.Quantity).ToString("N0"))₫
                                            </td>
                                            <td>
                                                <a href="/Cart/Remove/@item.ProductId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                                    <i class="bi bi-x-lg"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <i class="bi bi-cart-x fs-1 text-muted"></i>
                                            <p class="mt-2">Giỏ hàng của bạn đang trống.</p>
                                            <a href="/" class="btn btn-primary mt-2">Mua sắm ngay</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary-card">
                    <h4 class="mb-4">Tổng Kết Đơn Hàng</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Đã chọn:</span>
                        <span class="fw-semibold" id="summary-count">0 sản phẩm</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Tạm tính:</span>
                        <span class="fw-semibold" id="summary-subtotal">0₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Phí Vận Chuyển</span>
                        <span class="text-success fw-semibold">Miễn Phí</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 pt-3 border-top">
                        <h5 class="fw-bold">Tổng Thanh Toán</h5>
                        <h5 class="fw-bold text-primary" id="summary-total">0₫</h5>
                    </div>

                    <button id="btn-checkout" class="btn btn-primary btn-lg w-100 fw-bold" onclick="proceedToCheckout()" disabled>
                        TIẾN HÀNH THANH TOÁN
                    </button>

                    <a href="/" class="btn btn-outline-secondary btn-lg w-100 mt-3 fw-bold">
                        TIẾP TỤC MUA SẮM
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- 1. KHAI BÁO BIẾN ---
            const selectAllCheckbox = document.getElementById('selectAll');
            const itemCheckboxes = document.querySelectorAll('.item-checkbox');
            const summaryCount = document.getElementById('summary-count');
            const summarySubtotal = document.getElementById('summary-subtotal');
            const summaryTotal = document.getElementById('summary-total');
            const checkoutBtn = document.getElementById('btn-checkout');

            // --- 2. HÀM ĐỊNH DẠNG TIỀN TỆ (VNĐ) ---
            const formatCurrency = (amount) => {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            };

            // --- 3. HÀM TÍNH TOÁN TỔNG TIỀN (LOGIC FRONTEND) ---
            window.updateCartSummary = function () {
                let totalAmount = 0;
                let totalCount = 0;
                let allChecked = true;
                let hasItem = false;

                const rows = document.querySelectorAll('.cart-item');

                if (rows.length === 0) allChecked = false;

                rows.forEach(row => {
                    hasItem = true;
                    const checkbox = row.querySelector('.item-checkbox');
                    const quantityInput = row.querySelector('.quantity-input');
                    const priceRaw = parseFloat(row.getAttribute('data-price'));
                    const quantity = parseInt(quantityInput.value) || 0;

                    // Tính thành tiền từng dòng (Hiển thị UI)
                    const lineTotal = priceRaw * quantity;
                    row.querySelector('.total-line-price').textContent = formatCurrency(lineTotal);

                    // Chỉ cộng vào tổng nếu được Check
                    if (checkbox.checked) {
                        totalAmount += lineTotal;
                        totalCount += quantity;
                    } else {
                        allChecked = false;
                    }
                });

                // Cập nhật hiển thị Summary
                summarySubtotal.textContent = formatCurrency(totalAmount);
                summaryTotal.textContent = formatCurrency(totalAmount);
                summaryCount.textContent = totalCount + ' sản phẩm';

                // Cập nhật trạng thái checkbox "Select All"
                if (selectAllCheckbox) selectAllCheckbox.checked = allChecked && hasItem;

                // Ẩn/Hiện nút thanh toán
                if (totalCount > 0) {
                    checkoutBtn.removeAttribute('disabled');
                } else {
                    checkoutBtn.setAttribute('disabled', 'true');
                }
            };

            // --- 4. SỰ KIỆN (EVENT LISTENERS) ---

            // Xử lý nút "Chọn tất cả"
            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    document.querySelectorAll('.item-checkbox').forEach(cb => {
                        cb.checked = isChecked;
                    });
                    updateCartSummary();
                });
            }

            // Xử lý khi chọn từng checkbox
            const cartBody = document.getElementById('cart-body');
            if (cartBody) {
                cartBody.addEventListener('change', function (e) {
                    if (e.target.classList.contains('item-checkbox')) {
                        updateCartSummary();
                    }
                });
            }

            // Gọi lần đầu để reset trạng thái
            updateCartSummary();
        });

        // --- 5. HÀM XỬ LÝ KHI ĐỔI SỐ LƯỢNG ---
        // Hàm này được gọi từ onchange của input
        function handleQuantityChange(inputElement, productId) {
            let quantity = parseInt(inputElement.value);
            if (quantity < 1) {
                inputElement.value = 1;
                quantity = 1;
            }

            // Cập nhật tính toán Frontend ngay lập tức cho mượt
            window.updateCartSummary();

            // TODO: Kết nối Logic Server sau
            // Ở bước sau, bạn có thể bỏ comment dòng dưới để cập nhật Database
            // window.location.href = '/Cart/Update?productId=' + productId + '&quantity=' + quantity;
            console.log("Đã đổi số lượng SP " + productId + " thành " + quantity + ". Cần gọi Ajax/Redirect để lưu DB.");
        }

        // --- 6. HÀM XỬ LÝ THANH TOÁN ---
        function proceedToCheckout() {
            // Lấy danh sách ID các sản phẩm được chọn
            const selectedIds = [];
            document.querySelectorAll('.cart-item').forEach(row => {
                const checkbox = row.querySelector('.item-checkbox');
                if (checkbox.checked) {
                    selectedIds.push(row.getAttribute('data-id'));
                }
            });

            if (selectedIds.length === 0) {
                alert('Vui lòng chọn ít nhất 1 sản phẩm để thanh toán.');
                return;
            }

            console.log("Thanh toán các ID:", selectedIds);
            // TODO: Chuyển hướng sang trang Checkout với danh sách ID
            // window.location.href = '/ThanhToan/Checkout?ids=' + selectedIds.join(',');

            // Tạm thời chuyển hướng như cũ (thanh toán hết hoặc xử lý ở Controller)
            window.location.href = '/ThanhToan/Checkout';
        }
    </script>
}