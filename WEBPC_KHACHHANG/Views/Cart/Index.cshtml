@*@model List<WEBPC_KHACHHANG.Models.ViewModels.CartItemViewModel>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cart-container {
        padding: 40px 0;
        min-height: 600px;
    }

    .cart-header {
        font-weight: bold;
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .cart-item {
        border-bottom: 1px solid #eee;
        vertical-align: middle;
    }

        .cart-item img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

    .qty-input {
        width: 60px;
        text-align: center;
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 5px;
    }

    .total-section {
        background-color: #f8f9fa;
        padding: 25px;
        border-radius: 12px;
        margin-top: 0;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .btn-checkout {
        width: 100%;
        padding: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .item-checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #0d6efd;
    }

    .cart-empty-state {
        text-align: center;
        padding: 50px 0;
    }

        .cart-empty-state i {
            font-size: 4rem;
            color: #dee2e6;
            margin-bottom: 20px;
        }
</style>

<div class="container cart-container">
    <h2 class="mb-4 fw-bold"><i class="fas fa-shopping-cart text-primary me-2"></i> Giỏ Hàng Của Bạn</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="table-responsive shadow-sm border rounded">
                    <table class="table mb-0" id="cart-table">
                        <thead class="cart-header text-center align-middle">
                            <tr>
                                <th scope="col" style="width: 5%;"><input type="checkbox" id="check-all" class="item-checkbox" title="Chọn tất cả"></th>
                                <th scope="col" style="width: 40%; text-align: left;">Sản phẩm</th>
                                <th scope="col" style="width: 15%;">Đơn giá</th>
                                <th scope="col" style="width: 15%;">Số lượng</th>
                                <th scope="col" style="width: 15%;">Thành tiền</th>
                                <th scope="col" style="width: 10%;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="cart-item text-center align-middle" data-id="@item.MaSanPham">
                                    <td>
                                        <input type="checkbox" class="item-checkbox select-item" onchange="updateCartTotal()">
                                    </td>
                                    <td class="text-start">
                                        <div class="d-flex align-items-center">
                                            <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })">
                                                <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "https://via.placeholder.com/150" : item.HinhAnh)"
                                                     alt="@item.TenSanPham" class="me-3"
                                                     onerror="this.src='https://via.placeholder.com/150?text=No+Image'">
                                            </a>
                                            <div>
                                                <h6 class="mb-1 text-dark fw-bold">
                                                    <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })" class="text-decoration-none text-dark">
                                                        @item.TenSanPham
                                                    </a>
                                                </h6>
                                                <small class="text-muted">Mã SP: #@item.MaSanPham</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="price fw-bold text-muted" data-price="@item.DonGia">
                                        @item.DonGia.ToString("N0")₫
                                    </td>

                                    <td>
                                        <input type="number" class="qty-input form-control-sm mx-auto"
                                               value="@item.SoLuong" min="1" max="99"
                                               onchange="updateQuantityAjax(this, @item.MaSanPham)">
                                    </td>

                                    <td class="row-total fw-bold text-primary">
                                        @item.ThanhTien.ToString("N0")₫
                                    </td>

                                    <td>
                                        <button class="btn btn-sm btn-outline-danger border-0" onclick="removeRowAjax(this, @item.MaSanPham)" title="Xóa khỏi giỏ">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="total-section sticky-top" style="top: 20px; z-index: 1;">
                    <h5 class="border-bottom pb-3 mb-3 fw-bold">Cộng Giỏ Hàng</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tạm tính:</span>
                        <span id="sub-total" class="fw-bold">0₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Giảm giá:</span>
                        <span class="text-success fw-bold">-0₫</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <span class="h6 mb-0">Tổng thanh toán:</span>
                        <span id="final-total" class="h4 text-danger fw-bold mb-0">0₫</span>
                    </div>

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fas fa-info-circle me-1"></i> Vui lòng tích chọn sản phẩm để thanh toán.
                    </div>

                    <button class="btn btn-primary btn-checkout shadow-sm" onclick="proceedToCheckout()">
                        Tiến Hành Đặt Hàng
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="cart-empty-state">
            <i class="fas fa-shopping-basket"></i>
            <h4 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-secondary mb-4">Hãy dạo một vòng cửa hàng để chọn cho mình những món đồ ưng ý nhé.</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-primary px-4 py-2 fw-bold">
                <i class="fas fa-cart-plus me-2"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // === 1. HIGHLIGHT MENU GIỎ HÀNG ===
            $('.navbar-nav .active, .menu .active, .nav-item.active, .nav-link.active').removeClass('active');

            // Tìm link chứa chữ "Cart" hoặc icon giỏ hàng
            var cartLink = $('a[href*="Cart"]');
            if (cartLink.length === 0) cartLink = $('i.fa-shopping-cart').closest('a');

            if (cartLink.length > 0) {
                cartLink.addClass('active');
                cartLink.closest('li').addClass('active');
            }

            // Gọi hàm update lần đầu để reset về 0đ (do chưa check ô nào)
            updateCartTotal();
        });

        // === 2. CÁC HÀM XỬ LÝ (FORMAT TIỀN) ===
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }

        // === 3. XỬ LÝ CHECKBOX ===
        // Chọn tất cả
        $('#check-all').change(function () {
            $('.select-item').prop('checked', $(this).prop('checked'));
            updateCartTotal();
        });

        // Chọn từng cái -> Kiểm tra nếu chọn hết thì tick luôn ô "Chọn tất cả"
        $(document).on('change', '.select-item', function () {
            var allChecked = $('.select-item:checked').length === $('.select-item').length;
            $('#check-all').prop('checked', allChecked);
            updateCartTotal();
        });

        // === 4. CẬP NHẬT TỔNG TIỀN ===
        function updateCartTotal() {
            let total = 0;
            let rows = document.querySelectorAll('.cart-item');

            rows.forEach(row => {
                let checkbox = row.querySelector('.select-item');
                // Chỉ tính tiền những dòng ĐƯỢC CHECK
                if (checkbox.checked) {
                    let priceStr = row.querySelector('.price').dataset.price;
                    let qtyStr = row.querySelector('.qty-input').value;

                    let price = parseFloat(priceStr) || 0;
                    let qty = parseInt(qtyStr) || 0;

                    total += price * qty;
                }
            });

            $('#sub-total').text(formatCurrency(total));
            $('#final-total').text(formatCurrency(total));
        }

        // === 5. AJAX CẬP NHẬT SỐ LƯỢNG ===
        window.updateQuantityAjax = function (input, productId) {
            let qty = parseInt(input.value);
            if (qty < 1 || isNaN(qty)) { input.value = 1; qty = 1; }

            // Gọi về Server
            $.post('/Cart/UpdateQuantity', { productId: productId, quantity: qty }, function (res) {
                if (res.success) {
                    // Update thành tiền của dòng đó
                    let row = input.closest('tr');
                    let price = parseFloat(row.querySelector('.price').dataset.price);
                    let rowTotal = price * qty;
                    row.querySelector('.row-total').innerText = formatCurrency(rowTotal);

                    // Update tổng giỏ hàng
                    updateCartTotal();
                } else {
                    alert("Lỗi cập nhật giỏ hàng!");
                }
            });
        }

        // === 6. AJAX XÓA SẢN PHẨM ===
        window.removeRowAjax = function (btn, productId) {
            if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                $.post('/Cart/Remove', { productId: productId }, function (res) {
                    if (res.success) {
                        // Xóa dòng HTML
                        $(btn).closest('tr').fadeOut(300, function () {
                            $(this).remove();
                            // Nếu hết sản phẩm thì reload lại trang để hiện "Giỏ hàng trống"
                            if ($('.cart-item').length === 0) {
                                location.reload();
                            } else {
                                updateCartTotal();
                            }
                        });
                    } else {
                        alert("Lỗi xóa sản phẩm!");
                    }
                });
            }
        }

        // === 7. THANH TOÁN ===
        window.proceedToCheckout = function () {
            let selectedItems = [];
            $('.select-item:checked').each(function () {
                let row = $(this).closest('tr');
                selectedItems.push(row.data('id'));
            });

            if (selectedItems.length === 0) {
                alert("Vui lòng tích chọn ít nhất một sản phẩm để thanh toán!");
                return;
            }

            // Gửi danh sách ID sang trang Thanh toán
            alert("Đã chọn " + selectedItems.length + " sản phẩm. Đang chuyển hướng...");
            // window.location.href = '/Checkout?ids=' + selectedItems.join(',');
        }
    </script>
}*@