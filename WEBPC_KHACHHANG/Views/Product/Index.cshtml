@model IEnumerable<WEBPC_KHACHHANG.Models.ViewModels.ProductViewModel>

@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isLoggedIn = Session["User"] != null ? "true" : "false";
}

<div class="container">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-list-ul me-2"></i> Danh Mục
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index", "Product")" class="list-group-item list-group-item-action @(ViewBag.CurrentCategory == null ? "active" : "")">
                        Tất cả sản phẩm
                    </a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <a href="@Url.Action("Index", "Product", new { categoryId = cat.MaDanhMuc })"
                               class="list-group-item list-group-item-action @(ViewBag.CurrentCategory == cat.MaDanhMuc ? "active" : "")">
                                @cat.TenDanhMuc
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
                <h4 class="mb-0 fw-bold text-dark">
                    @if (ViewBag.CurrentCategory != null)
                    {<span>Sản phẩm theo danh mục</span> }
                    else if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                    { <span>Kết quả tìm kiếm: "@ViewBag.CurrentSearch"</span> }
                else
                { <span>Tất cả sản phẩm</span>}
                </h4>
                <span class="text-muted small">Hiển thị @(Model != null ? Model.Count() : 0) sản phẩm</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card h-100 product-card border-0 shadow-sm">
                                <div class="position-relative overflow-hidden">
                                    <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })">
                                        <img src="@item.HinhAnhDaiDien" class="card-img-top p-3" alt="@item.TenSanPham" style="height: 250px; object-fit: contain;">
                                    </a>
                                    @if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai > 0)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-3">SALE</span>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fs-6">
                                        <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })" class="text-decoration-none text-dark fw-bold text-truncate-2">
                                            @item.TenSanPham
                                        </a>
                                    </h5>

                                    <div class="mt-auto">
                                        <div class="price-box mb-2">
                                            @if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai > 0)
                                            {
                                                <span class="text-danger fw-bold fs-5 me-2">@item.GiaKhuyenMai.Value.ToString("N0") đ</span>
                                                <span class="text-muted text-decoration-line-through small">@item.GiaBan.ToString("N0") đ</span>
                                            }
                                            else
                                            {
                                                <span class="text-primary fw-bold fs-5">@item.GiaBan.ToString("N0") đ</span>
                                            }
                                        </div>
                                        <div class="d-grid gap-2 d-flex mt-auto">
                                            <a href="@Url.Action("Detail", "Product", new { id = item.MaSanPham })" class="btn btn-outline-primary btn-sm flex-grow-1">Chi tiết</a>

                                            <button class="btn btn-primary btn-sm" onclick="addToCart(@item.MaSanPham)">
                                                <i class="bi bi-cart-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center py-5" role="alert">
                    <i class="bi bi-search fs-1 d-block mb-3"></i>
                    <h5>Không tìm thấy sản phẩm nào!</h5>
                    <p>Vui lòng thử lại với từ khóa khác hoặc danh mục khác.</p>
                    <a href="@Url.Action("Index", "Product")" class="btn btn-primary mt-2">Xem tất cả sản phẩm</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal thông báo thêm vào giỏ thành công -->
<div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addToCartModalLabel">
                    <i class="bi bi-check-circle me-2"></i>Thành công!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-cart-check text-success" style="font-size: 3rem;"></i>
                <p class="mt-3 mb-0">Sản phẩm đã được thêm vào giỏ hàng!</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tiếp tục mua sắm</button>
                <a href="@Url.Action("Index", "Cart")" class="btn btn-primary">Xem giỏ hàng</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(id) {
            // 1. Kiểm tra trạng thái đăng nhập
            // Biến này lấy từ Razor ở đầu file
            var isUserLoggedIn = '@isLoggedIn';

            if (isUserLoggedIn === "false") {
                // 2. Nếu chưa đăng nhập: Xử lý hiển thị Modal hoặc chuyển trang
                var loginModalElement = document.getElementById('loginModal');

                // Kiểm tra xem Modal có tồn tại không và Bootstrap đã load chưa
                if (loginModalElement && typeof bootstrap !== 'undefined') {
                    var myModal = new bootstrap.Modal(loginModalElement);
                    myModal.show();
                } else {
                    // Fallback: Nếu không có modal thì confirm chuyển trang
                    if(confirm('Bạn cần đăng nhập để thêm sản phẩm. Chuyển đến trang đăng nhập?')) {
                        window.location.href = '@Url.Action("Index", "Login")';
                    }
                }
                return; // Dừng lại, không chạy code thêm giỏ hàng phía dưới
            }

            // 3. Nếu đã đăng nhập: Thực hiện Submit form
            // KHẮC PHỤC LỖI: Ở trang Index không có ô nhập số lượng, nên ta gán cứng là 1
            var qty = 1;

            // Tạo form ẩn dynamic để submit POST
            var form = document.createElement("form");
            form.method = "POST";
            form.action = "/Cart/AddToCart";

            // Input ID Sản phẩm
            var inputId = document.createElement("input");
            inputId.type = "hidden";

            // LƯU Ý QUAN TRỌNG:
            // Nếu bên Controller bạn viết: public IActionResult AddToCart(int id, ...) -> thì để name="id"
            // Nếu bên Controller bạn viết: public IActionResult AddToCart(int productId, ...) -> thì đổi thành name="productId"
            inputId.name = "productId";
            inputId.value = id;
            form.appendChild(inputId);

            // Input Số lượng
            var inputQty = document.createElement("input");
            inputQty.type = "hidden";
            inputQty.name = "quantity";
            inputQty.value = qty;
            form.appendChild(inputQty);

            // Gắn form vào body và submit
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}