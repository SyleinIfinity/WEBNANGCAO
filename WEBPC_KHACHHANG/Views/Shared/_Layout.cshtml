
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TechParts</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Custom styles -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/styles.css")" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="header-main">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="#">
                    <i class="bi bi-cpu-fill text-primary fs-3 me-2"></i>
                    <span class="fw-bold fs-4">TechParts</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto me-4">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Trang Chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product")">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "BuildPC")">Cấu hình</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Liên hệ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Hỗ trợ</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Promotions")">Khuyến Mãi</a></li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <div class="search-box me-3">
                            <i class="bi bi-search"></i>
                            <input type="text" placeholder="Tìm kiếm sản phẩm..." />
                        </div>

                        @if (Session["UserToken"] != null)
                        {
                            <div class="dropdown me-3">
                                <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-4 text-primary me-2"></i>
                                    <span class="fw-bold d-none d-md-block">@Session["UserName"]</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><span class="dropdown-item-text text-muted small">Xin chào, @Session["UserName"]</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "InfoUser")"><i class="bi bi-person-badge me-2"></i>Hồ sơ cá nhân</a></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "InfoAddress")">
                                            <i class="bi bi-geo-alt me-2"></i>Sổ địa chỉ
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "DonHang")">
                                            <i class="bi bi-box-seam"></i> Lịch sử đơn hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Login")"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="#" class="text-dark me-3" data-bs-toggle="modal" data-bs-target="#loginModal" title="Đăng nhập">
                                <i class="bi bi-person fs-5"></i>
                            </a>
                        }
                        <a href="@Url.Action("Index", "Cart")" class="text-dark position-relative">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span class="cart-badge"></span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Body render -->
    <main class="container-fluid p-0">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title mb-3">TechParts</h5>
                    <p class="footer-text">Cửa hàng một điểm dừng của bạn cho các linh kiện điện tử.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title mb-3">Dịch Vụ Khách Hàng</h5>
                    <ul class="footer-links">
                        <li><a href="#">Liên Hệ</a></li>
                        <li><a href="#">Câu Hỏi Thường Gặp</a></li>
                        <li><a href="#">Vận Chuyển & Trả Hàng</a></li>
                        <li><a href="#">Theo Dõi Đơn Hàng</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title mb-3">Thông Tin Công Ty</h5>
                    <ul class="footer-links">
                        <li><a href="#">Về Chúng Tôi</a></li>
                        <li><a href="#">Tuyển Dụng</a></li>
                        <li><a href="#">Tin Tức</a></li>
                        <li><a href="#">Chương Trình Đối Tác</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title mb-3">Tài Khoản Của Tôi</h5>
                    <ul class="footer-links">
                        <li><a href="#">Đăng Nhập / Đăng Ký</a></li>
                        <li><a href="#">Lịch Sử Đơn Hàng</a></li>
                        <li><a href="#">Danh Sách Yêu Thích</a></li>
                    </ul>
                </div>
            </div>

            <div class="row mt-4 pt-4 border-top">
                <div class="col-md-6">
                    <p class="footer-text mb-0">Theo Dõi Chúng Tôi</p>
                    <div class="social-links mt-2">
                        <a href="#"><i class="bi bi-twitter"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="footer-text mb-0">Đăng ký nhận bản tin để nhận ưu đãi và tin tức công nghệ mới nhất.</p>
                    <div class="newsletter-form mt-2">
                        <input type="email" placeholder="Nhập email của bạn" />
                        <button class="btn btn-primary">Đăng Ký</button>
                    </div>
                </div>
            </div>
        </div>
        @*<div class="modal fade" id="addToCartModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title"><i class="fas fa-check-circle"></i> Đã thêm vào giỏ hàng!</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center py-4">
                            <p class="fs-5">Sản phẩm đã được thêm vào giỏ hàng của bạn.</p>
                            <div class="mt-3">
                                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Tiếp tục mua sắm</button>
                                <a href="/Cart" class="btn btn-primary">Xem giỏ hàng</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>*@

        <div class="footer-bottom">
            <div class="container">
                <p class="mb-0 text-center">© 2024 TechParts. Tất cả quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>
    @Html.Partial("_LoginModal")
    @Html.Action("RenderChatBox", "Chat")
    <!-- Bootstrap JS -->
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    @RenderSection("scripts", required: false)

</body>
@if (TempData["LoginSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"
         style="position:fixed; top:20px; right:20px; z-index:9999;">
        @TempData["LoginSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

</html>