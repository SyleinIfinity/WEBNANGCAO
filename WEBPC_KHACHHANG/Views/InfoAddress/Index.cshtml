@{
    ViewBag.Title = "InfoAddress";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/infoaddress.css" rel="stylesheet" />
}

<section class="py-5 bg-light min-vh-100">
    <div class="container">
        <h2 class="mb-4 fw-bold">Tài Khoản Của Tôi</h2>
        <div class="row g-4">

            <div class="col-lg-3">
                <div class="card p-3 shadow-sm">
                    <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                        <img src="https://via.placeholder.com/60" class="rounded-circle me-3 border" alt="Avatar">
                        <div>
                            <p class="mb-0 fw-bold">Xin chào,</p>
                            <p class="mb-0 text-primary fw-semibold">Tên người dùng Demo</p>
                        </div>
                    </div>
                    <ul class="nav nav-pills flex-column user-dashboard-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "InfoUser")">
                                <i class="bi bi-person-circle me-2"></i>Thông tin cá nhân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-card-checklist me-2"></i>Lịch sử đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active-info" href="@Url.Action("Index", "InfoAddress")">
                                <i class="bi bi-geo-alt me-2"></i>Sổ địa chỉ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-lock me-2"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li class="nav-item mt-3">
                            <a class="nav-link text-danger" href="login.html">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                        <h4 class="fw-bold mb-0">Sổ Địa Chỉ Của Tôi</h4>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addressModal">
                            <i class="bi bi-plus-lg me-1"></i> Thêm Địa Chỉ Mới
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-4 address-card bg-light">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">Địa Chỉ Nhà <span class="address-default-badge ms-2">MẶC ĐỊNH</span></h5>
                                    <div class="address-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="modal" data-bs-target="#addressModal">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </div>
                                </div>
                                <p class="mb-1">Người nhận: **Tên người dùng Demo** | 0901 234 567</p>
                                <p class="mb-0 text-muted">
                                    Địa chỉ: **25 Đường ABC**, Phường 10, **Quận Bình Thạnh**, **Hồ Chí Minh**
                                </p>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-4 address-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">Địa Chỉ Văn Phòng</h5>
                                    <div class="address-actions">
                                        <button class="btn btn-sm btn-outline-primary me-2">
                                            <i class="bi bi-pin-map me-1"></i> Đặt làm mặc định
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="modal" data-bs-target="#addressModal">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </div>
                                </div>
                                <p class="mb-1">Người nhận: **Tên người dùng Demo** | 0901 234 567</p>
                                <p class="mb-0 text-muted">
                                    Địa chỉ: **Tầng 5, Tòa nhà XYZ**, Đường số 1, **Quận Cầu Giấy**, **Hà Nội**
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thêm/Sửa Địa Chỉ Giao Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="recipientName" class="form-label fw-semibold">Tên người nhận</label>
                            <input type="text" class="form-control form-control-lg" id="recipientName" value="Tên người dùng Demo">
                        </div>
                        <div class="col-md-6">
                            <label for="recipientPhone" class="form-label fw-semibold">Số điện thoại</label>
                            <input type="tel" class="form-control form-control-lg" id="recipientPhone" value="0901 234 567">
                        </div>

                        <div class="col-md-6">
                            <label for="cityModal" class="form-label fw-semibold">Tỉnh/Thành phố</label>
                            <select class="form-select form-control-lg" id="cityModal">
                                <option selected disabled>Chọn Tỉnh/Thành phố</option>
                                <option>Hà Nội</option>
                                <option selected>Hồ Chí Minh</option>
                                <option>Đà Nẵng</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="districtModal" class="form-label fw-semibold">Quận/Huyện</label>
                            <select class="form-select form-control-lg" id="districtModal">
                                <option disabled>Chọn Quận/Huyện</option>
                                <option selected>Quận Bình Thạnh</option>
                                <option>Quận 1</option>
                                <option>Quận Hải Châu</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="specificAddressModal" class="form-label fw-semibold">Địa chỉ cụ thể</label>
                            <input type="text" class="form-control form-control-lg" id="specificAddressModal" placeholder="Số nhà, tên đường, thôn/xóm" value="25 Đường ABC, Phường 10">
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="defaultAddress" checked>
                                <label class="form-check-label fw-semibold" for="defaultAddress">
                                    Đặt làm địa chỉ mặc định
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary">Lưu Địa Chỉ</button>
            </div>
        </div>
    </div>
</div>
