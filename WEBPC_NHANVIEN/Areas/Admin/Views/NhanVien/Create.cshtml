@model IEnumerable<WEBPC_NHANVIEN.Areas.Admin.Models.NhanVienCreateViewModel>


@{
    ViewBag.Title = "Thêm nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Thêm nhân viên</h2>
<p class="text-muted">Tạo mới thông tin nhân viên và tài khoản đăng nhập.</p>

@using (Html.BeginForm("Create", "NhanVien", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header"><strong>Thông tin cá nhân</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>Họ tên *</label>
                        <input type="text" name="HoTen" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Số điện thoại</label>
                        <input type="text" name="SoDienThoai" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" name="Email" class="form-control" />
                    </div>

                    <div>
                        <label>Vai trò *</label>
                        @Html.DropDownList(
                            "MaVaiTro",
                            ViewBag.Roles as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(),
                            "-- Chọn vai trò --",
                            new { @class = "form-select" })
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header"><strong>Tài khoản</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>Tên đăng nhập *</label>
                        <input type="text" name="TenDangNhap" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Mật khẩu *</label>
                        <input type="password" name="MatKhau" class="form-control" />
                    </div>

                    <div>
                        <label>Trạng thái</label>
                        <select name="TrangThaiTaiKhoan" class="form-select">
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Khoá">Khoá</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", "NhanVien", new { area = "Admin" })"
                   class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-success">Lưu</button>
            </div>
        </div>
    </div>
}
