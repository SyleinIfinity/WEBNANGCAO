@model IEnumerable<WEBPC_NHANVIEN.Areas.Admin.Models.KhachHangViewModel>

@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-primary fw-bold mb-0">Danh sách Khách hàng</h4>
            <p class="text-muted small mb-0">Quản lý thông tin và trạng thái tài khoản</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Thêm mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm border-start border-success border-4 rounded-3">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm border-start border-danger border-4 rounded-3">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="card shadow border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="py-3 ps-4 border-0">Mã KH</th>
                            <th class="py-3 border-0">Họ tên & Email</th>
                            <th class="py-3 border-0">Số điện thoại</th>
                            <th class="py-3 border-0 text-center">Trạng thái</th>
                            <th class="py-3 pe-4 border-0 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="border-bottom border-light">
                                    <td class="ps-4 fw-bold text-muted">#@item.MaNguoiDung</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width: 40px; height: 40px; font-weight: bold;">
                                                @(item.HoTen.Length > 0 ? item.HoTen.Substring(0,1).ToUpper() : "?")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.HoTen</div>
                                                <small class="text-muted">@item.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-dark">@item.SoDienThoai</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == 1)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25">
                                                <i class="fas fa-check-circle me-1"></i>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary border-opacity-25">
                                                <i class="fas fa-lock me-1"></i>Đã khóa
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@Url.Action("Edit", new { id = item.MaNguoiDung })"
                                           class="btn btn-outline-primary btn-sm rounded-circle shadow-sm" title="Sửa" style="width: 32px; height: 32px; padding: 4px;">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.MaNguoiDung })"
                                           class="btn btn-outline-danger btn-sm rounded-circle shadow-sm ms-1"
                                           onclick="return confirm('Bạn có chắc muốn xóa khách hàng này?');" title="Xóa" style="width: 32px; height: 32px; padding: 4px;">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 text-secondary opacity-50"></i>
                                    <p>Không có dữ liệu khách hàng nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>