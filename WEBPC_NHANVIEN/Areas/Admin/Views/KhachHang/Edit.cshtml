@model WEBPC_NHANVIEN.Areas.Admin.Models.KhachHangViewModel

@{
    ViewBag.Title = "Cập nhật thông tin khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="text-primary fw-bold mb-0">Cập Nhật Thông Tin</h4>
            <p class="text-muted small mb-0">Khách hàng: <span class="fw-bold text-dark">@Model.HoTen</span></p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 me-3">
                            <i class="fas fa-user-edit fa-lg"></i>
                        </div>
                        <h6 class="m-0 font-weight-bold text-dark">Form chỉnh sửa hồ sơ</h6>
                    </div>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.MaNguoiDung)

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.HoTen, new { @class = "form-label fw-bold" })
                                        @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.Email, new { @class = "form-label fw-bold" })
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fas fa-envelope"></i></span>
                                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.SoDienThoai, new { @class = "form-label fw-bold" })
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fas fa-phone"></i></span>
                                            @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control" } })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.GioiTinh, new { @class = "form-label fw-bold" })
                                        @Html.DropDownListFor(model => model.GioiTinh, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Nam", Value = "Nam" },
                                            new SelectListItem { Text = "Nữ", Value = "Nữ" },
                                            new SelectListItem { Text = "Khác", Value = "Khác" }
                                        }, "Chọn giới tính", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.TrangThai, new { @class = "form-label fw-bold" })
                                        <div class="p-3 bg-light rounded-3 border">
                                            <div class="form-check form-check-inline">
                                                @Html.RadioButtonFor(m => m.TrangThai, 1, new { @class = "form-check-input", id = "statusActive" })
                                                <label class="form-check-label text-success fw-bold" for="statusActive">
                                                    <i class="fas fa-check-circle me-1"></i>Hoạt động
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline ms-3">
                                                @Html.RadioButtonFor(m => m.TrangThai, 0, new { @class = "form-check-input", id = "statusLock" })
                                                <label class="form-check-label text-secondary" for="statusLock">
                                                    <i class="fas fa-lock me-1"></i>Đã khóa
                                                </label>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 rounded-pill">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </a>
                                <button type="submit" class="btn btn-warning text-dark fw-bold px-4 rounded-pill shadow-sm">
                                    <i class="fas fa-save me-2"></i>Lưu thay đổi
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>