@model WEBPC_NHANVIEN.Areas.Admin.Models.KhachHangViewModel

@{
    ViewBag.Title = "Cập nhật thông tin khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(245, 87, 108, 0.3);
    }

        .page-header h4 {
            color: white;
            font-weight: 700;
            margin: 0;
            font-size: 1.8rem;
        }

        .page-header .customer-name {
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            display: inline-block;
            margin-top: 0.5rem;
        }

            .page-header .customer-name span {
                color: white;
                font-weight: 600;
            }

    .edit-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .header-content {
        display: flex;
        align-items: center;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        color: white;
        font-size: 1.3rem;
    }

    .header-title h6 {
        margin: 0;
        font-weight: 700;
        font-size: 1.1rem;
        color: #2d3748;
    }

    .card-body-custom {
        padding: 2.5rem;
    }

    .section-divider {
        display: flex;
        align-items: center;
        margin: 2rem 0 1.5rem;
    }

        .section-divider::before,
        .section-divider::after {
            content: '';
            flex: 1;
            height: 2px;
            background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
        }

        .section-divider span {
            padding: 0 1rem;
            font-weight: 600;
            color: #4a5568;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }

        .form-label i {
            margin-right: 0.5rem;
            color: #f5576c;
        }

    .input-group-text {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        border: none;
        color: white;
        width: 45px;
        justify-content: center;
    }

    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #f5576c;
            box-shadow: 0 0 0 3px rgba(245, 87, 108, 0.1);
        }

    .input-group .form-control,
    .input-group .form-select {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .status-section {
        background: linear-gradient(135deg, #667eea10 0%, #764ba210 100%);
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
    }

        .status-section .form-label {
            margin-bottom: 1rem;
        }

    .form-check-inline {
        background: white;
        padding: 1rem 1.5rem;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        margin-right: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .form-check-inline:hover {
            border-color: #f5576c;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    .form-check-input:checked + label {
        font-weight: 700;
    }

    .form-check-inline .form-check-input {
        margin-top: 0.25rem;
    }

    .form-check-label {
        cursor: pointer;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        font-size: 0.95rem;
    }

        .form-check-label i {
            margin-right: 0.5rem;
            font-size: 1rem;
        }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #f0f0f0;
    }

    .btn-back {
        background: white;
        border: 2px solid #cbd5e0;
        color: #4a5568;
        padding: 0.75rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            background: #f7fafc;
            border-color: #a0aec0;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    .btn-submit {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(245, 87, 108, 0.3);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(245, 87, 108, 0.4);
        }

    .validation-message {
        color: #e53e3e;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    @@media (max-width: 767px) {
        .form-check-inline {
            display: block;
            margin-bottom: 1rem;
        }
    }
</style>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="page-header">
        <h4>
            <i class="fas fa-user-edit me-2"></i>Cập Nhật Thông Tin
        </h4>
        <div class="customer-name">
            <i class="fas fa-user me-2"></i>
            <span>@Model.HoTen</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="edit-card">
                <div class="card-header-custom">
                    <div class="header-content">
                        <div class="header-icon">
                            <i class="fas fa-edit"></i>
                        </div>
                        <div class="header-title">
                            <h6>Form Chỉnh Sửa Hồ Sơ Khách Hàng</h6>
                        </div>
                    </div>
                </div>

                <div class="card-body-custom">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.MaNguoiDung)

                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm mb-4" style="border-left: 4px solid #e53e3e; border-radius: 10px;">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <strong>Vui lòng kiểm tra lại thông tin!</strong>
                                @Html.ValidationSummary(true, "", new { @class = "mb-0 mt-2" })
                            </div>
                        }

                        <div class="row">
                            <!-- Cột trái -->
                            <div class="col-md-6 mb-4">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.HoTen, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập họ và tên đầy đủ" } })
                                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group mb-4">
                                    <label class="form-label">
                                        <i class="fas fa-envelope"></i> Email
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-at"></i>
                                        </span>
                                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "email@example.com" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group mb-4">
                                    <label class="form-label">
                                        <i class="fas fa-phone"></i> Số điện thoại
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-mobile-alt"></i>
                                        </span>
                                        @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control", placeholder = "09xxxxxxxx" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "validation-message" })
                                </div>
                            </div>

                            <!-- Cột phải -->
                            <div class="col-md-6 mb-4">
                                <div class="form-group mb-4">
                                    <label class="form-label">
                                        <i class="fas fa-venus-mars"></i> Giới tính
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        @Html.DropDownListFor(model => model.GioiTinh, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Chọn giới tính", Value = "" },
                                            new SelectListItem { Text = "Nam", Value = "Nam" },
                                            new SelectListItem { Text = "Nữ", Value = "Nữ" },
                                            new SelectListItem { Text = "Khác", Value = "Khác" }
                                        }, new { @class = "form-select" })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        <i class="fas fa-toggle-on"></i> Trạng thái tài khoản
                                    </label>
                                    <div class="status-section">
                                        <div class="form-check form-check-inline">
                                            @Html.RadioButtonFor(m => m.TrangThai, 1, new { @class = "form-check-input", id = "statusActive" })
                                            <label class="form-check-label text-success" for="statusActive">
                                                <i class="fas fa-check-circle"></i>Hoạt động
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            @Html.RadioButtonFor(m => m.TrangThai, 0, new { @class = "form-check-input", id = "statusLock" })
                                            <label class="form-check-label text-danger" for="statusLock">
                                                <i class="fas fa-lock"></i>Đã khóa
                                            </label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "validation-message" })
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <a href="@Url.Action("Index")" class="btn-back">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                            <button type="submit" class="btn-submit">
                                <i class="fas fa-save me-2"></i>Lưu thay đổi
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>