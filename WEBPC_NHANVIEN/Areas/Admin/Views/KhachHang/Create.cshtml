@model WEBPC_NHANVIEN.Areas.Admin.Models.KhachHangViewModel

@{
    ViewBag.Title = "Thêm khách hàng mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="text-primary fw-bold mb-0">Thêm Khách Hàng Mới</h4>
            <p class="text-muted small mb-0">Tạo tài khoản và thông tin hồ sơ khách hàng</p>
        </div>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 border-start border-danger border-4" })

                <div class="row g-4">
                    <div class="col-lg-5 border-end-lg">
                        <h6 class="text-uppercase text-secondary fw-bold small mb-3">
                            <i class="fas fa-user-shield me-2"></i>Thông tin tài khoản
                        </h6>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.TenDangNhap, new { @class = "form-label fw-bold text-dark" })
                            <div class="input-group">
                                <span class="input-group-text bg-light text-primary"><i class="fas fa-user"></i></span>
                                @Html.EditorFor(model => model.TenDangNhap, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên đăng nhập..." } })
                            </div>
                            @Html.ValidationMessageFor(model => model.TenDangNhap, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.MatKhau, new { @class = "form-label fw-bold text-dark" })
                            <div class="input-group">
                                <span class="input-group-text bg-light text-primary"><i class="fas fa-lock"></i></span>
                                @Html.EditorFor(model => model.MatKhau, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập mật khẩu...", type = "password", id = "InputMatKhau" } })
                                <button class="btn btn-outline-secondary" type="button" id="btnTogglePass">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="alert alert-info small mt-4 rounded-3 border-0 bg-info bg-opacity-10 text-info">
                            <i class="fas fa-info-circle me-1"></i> Lưu ý: Tên đăng nhập không thể thay đổi sau khi tạo.
                        </div>
                    </div>

                    <div class="col-lg-7 ps-lg-4">
                        <h6 class="text-uppercase text-secondary fw-bold small mb-3">
                            <i class="fas fa-id-card me-2"></i>Thông tin cá nhân
                        </h6>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.HoTen, new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Nguyễn Văn A" } })
                            @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(model => model.Email, new { @class = "form-label fw-bold" })
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "email@example.com" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(model => model.SoDienThoai, new { @class = "form-label fw-bold" })
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-phone text-muted"></i></span>
                                    @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control", placeholder = "09xxxxxxxx" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.GioiTinh, new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-venus-mars text-muted"></i></span>
                                @Html.DropDownListFor(model => model.GioiTinh, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Nam", Value = "Nam" },
                                    new SelectListItem { Text = "Nữ", Value = "Nữ" },
                                    new SelectListItem { Text = "Khác", Value = "Khác" }
                                }, "Chọn giới tính", new { @class = "form-select" })
                            </div>
                            @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                        <i class="fas fa-save me-2"></i>Tạo tài khoản
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Areas/Admin/Scripts/khachhang-custom.js"></script>
}