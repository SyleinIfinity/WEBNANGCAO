@model WEBPC_NHANVIEN.Areas.Admin.Models.PhieuNhapEditViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Cập nhật phiếu nhập: @Model.MaCodePhieu</h2>

@using (Html.BeginForm("Edit", "PhieuNhap", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaPhieuNhap)

    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> Bạn chỉ có thể cập nhật ghi chú. Để sửa số lượng hoặc giá, vui lòng xóa phiếu và tạo lại.
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Ngày nhập:</strong> @Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Người nhập:</strong> @Model.TenNhanVien</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Ghi chú</label>
                    @Html.TextAreaFor(m => m.GhiChu, 3, 50, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.GhiChu, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <h5>Chi tiết phiếu (Chỉ xem)</h5>
    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ChiTietHienThi != null)
            {
                foreach (var item in Model.ChiTietHienThi)
                {
                    <tr>
                        <td>@item.TenSanPham</td>
                        <td class="text-center">@item.SoLuongNhap</td>
                        <td class="text-end">@item.GiaNhap.ToString("N0")</td>
                        <td class="text-end">@item.ThanhTien.ToString("N0")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-3">
        <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
    </div>
}