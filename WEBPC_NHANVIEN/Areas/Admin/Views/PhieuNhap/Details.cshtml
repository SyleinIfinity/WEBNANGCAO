@model WEBPC_NHANVIEN.Areas.Admin.Models.PhieuNhapResponseViewModel
@{
    ViewBag.Title = "Chi tiết phiếu nhập";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body p-5">

            <div class="row justify-content-between align-items-center mb-5 border-bottom pb-4">
                <div class="col-md-6">
                    <h4 class="text-uppercase text-primary fw-bold mb-1">
                        <i class="fas fa-cube me-2"></i>Phiếu Nhập Kho
                    </h4>
                    <span class="text-muted">Mã phiếu: </span>
                    <span class="badge bg-secondary text-light fs-6">#@Model.MaCodePhieu</span>
                </div>
                <div class="col-md-6 text-end">
                    <h5 class="mb-1 fw-bold text-dark">Ngày nhập</h5>
                    <div class="text-primary fs-5">@Model.NgayNhap.ToString("dd/MM/yyyy")</div>
                    <small class="text-muted">Lúc: @Model.NgayNhap.ToString("HH:mm")</small>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-md-5">
                    <h6 class="text-uppercase text-secondary small fw-bold mb-3">Người thực hiện</h6>
                    <div class="d-flex align-items-center p-3 bg-light rounded-3">
                        <div class="bg-white rounded-circle p-3 shadow-sm me-3 text-primary">
                            <i class="fas fa-user-tie fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">@Model.TenNhanVien</h5>
                            <small class="text-muted">Nhân viên kho</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <h6 class="text-uppercase text-secondary small fw-bold mb-3">Ghi chú</h6>
                    <div class="p-3 bg-light rounded-3 border-start border-4 border-info h-100">
                        <p class="mb-0 fst-italic text-secondary">
                            @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)
                        </p>
                    </div>
                </div>
            </div>

            <h6 class="text-uppercase text-secondary small fw-bold mb-3">Chi tiết hàng hóa</h6>
            <div class="table-responsive mb-4 rounded-3 overflow-hidden border">
                <table class="table table-borderless table-striped align-middle mb-0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="py-3 ps-4">Sản phẩm</th>
                            <th class="py-3 text-center">Số lượng</th>
                            <th class="py-3 text-end">Đơn giá</th>
                            <th class="py-3 text-end pe-4">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ChiTiet)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark">
                                    <i class="fas fa-box text-muted me-2"></i>@item.TenSanPham
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge bg-white text-dark border shadow-sm px-3 py-2 rounded-pill">
                                        @item.SoLuongNhap
                                    </span>
                                </td>
                                <td class="text-end py-3 text-secondary">@item.GiaNhap.ToString("N0") ₫</td>
                                <td class="text-end pe-4 py-3 fw-bold text-primary">@item.ThanhTien.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5 col-lg-4">
                    <div class="bg-primary bg-opacity-10 p-4 rounded-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-dark fw-bold">Tổng số lượng:</span>
                            <span class="fw-bold text-dark">@Model.ChiTiet.Sum(x => x.SoLuongNhap)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-primary border-opacity-25">
                            <h5 class="mb-0 text-primary fw-bold">TỔNG CỘNG:</h5>
                            <h3 class="mb-0 text-danger fw-bold">@Model.TongTienNhap.ToString("N0") ₫</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-dark rounded-pill px-4" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>In phiếu
                    </button>
                    <a href="@Url.Action("Edit", new { id = Model.MaPhieuNhap })" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">
                        <i class="fas fa-edit me-2"></i>Chỉnh sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>