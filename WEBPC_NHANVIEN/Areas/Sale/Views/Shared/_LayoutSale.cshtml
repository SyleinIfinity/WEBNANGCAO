<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sale Admin</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        body {
            overflow-x: hidden;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f4f6f9;
        }

        #wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }

        /* === MENU TRÁI (SIDEBAR) === */
        #sidebar-wrapper {
            min-width: 260px;
            max-width: 260px;
            background-color: #6f42c1; /* Màu Tím */
            color: #fff;
            transition: all 0.3s;
            min-height: 100vh;
        }

        .sidebar-heading {
            padding: 1.5rem;
            font-size: 1.5rem;
            font-weight: bold;
            color: #fff;
            text-align: center;
            background: rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        #sidebar-wrapper .list-group-item {
            display: block;
            width: 100%;
            text-align: left;
            background-color: transparent;
            color: rgba(255, 255, 255, 0.8);
            border: none;
            padding: 15px 25px;
            font-size: 1.1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            text-decoration: none;
        }

            #sidebar-wrapper .list-group-item:hover {
                background-color: rgba(255, 255, 255, 0.2);
                color: #fff;
                transform: scale(1.05);
                transition: all 0.2s;
            }

        /* === BÊN PHẢI === */
        #page-content-wrapper {
            width: 100%;
            background-color: #f4f6f9;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background-color: #AFEEEE;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            padding: 10px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-right-group {
            display: flex !important;
            align-items: center !important;
            flex-direction: row !important;
        }

        .page-title {
            font-size: 1.25rem;
            font-weight: bold;
            color: #333;
            margin: 0;
        }

        /* === NÚT CHẤM CÔNG (ĐÃ FIX LỖI) === */
        .btn-cham-cong {
            display: inline-flex;
            align-items: center;
            justify-content: center; /* Canh giữa icon */
            background: #fff;
            color: #6f42c1;
            border-radius: 50px;
            padding: 0;
            text-decoration: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.4s ease;
            height: 40px;
            width: 40px; /* Hình tròn 40x40 */
            overflow: hidden;
            white-space: nowrap;
            vertical-align: middle;
        }

            .btn-cham-cong:hover {
                background-color: #6f42c1;
                color: #fff;
                width: 170px; /* Dài ra khi hover */
                padding: 0 15px;
                justify-content: flex-start; /* Khi dài ra thì canh trái cho đẹp */
            }

            .btn-cham-cong i {
                font-size: 1.2rem;
                min-width: 40px; /* Đảm bảo icon luôn có chỗ đứng ở giữa */
                display: flex;
                justify-content: center;
                align-items: center;
            }

        .text-cham-cong {
            /* QUAN TRỌNG: Thêm max-width: 0 để nó không chiếm chỗ khi chưa hover */
            max-width: 0;
            opacity: 0;
            transition: all 0.4s ease;
            font-weight: bold;
            font-size: 0.9rem;
            overflow: hidden;
        }

        /* Khi hover thì hiện chữ ra */
        .btn-cham-cong:hover .text-cham-cong {
            max-width: 150px;
            opacity: 1;
            margin-left: 5px;
        }

        .separator-line {
            font-size: 1.5rem;
            color: #555;
            margin: 0 15px;
            font-weight: 300;
            line-height: 1;
            display: inline-block;
        }

        .user-name-text {
            font-weight: bold;
            color: #333;
            font-size: 1rem;
            white-space: nowrap;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .user-name-text:hover {
                color: #6f42c1;
                cursor: pointer;
            }

        .main-content-container {
            flex: 1;
            padding: 30px;
            margin: 30px;
            background: #fff;
            border-radius: 5px;
            box-shadow: 0 0 15px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>

    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="fas fa-user-shield me-2"></i> NHÂN VIÊN
            </div>
            <div class="list-group list-group-flush mt-3 d-flex flex-column">
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-gift me-2"></i> Khuyến Mãi
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-shopping-bag me-2"></i> Đơn Hàng
                </a>
            </div>
        </div>

        <div id="page-content-wrapper">

            <nav class="navbar-custom">
                <h2 class="page-title">Hệ thống quản lý</h2>

                <div class="header-right-group">

                    <a href="#" class="btn-cham-cong" title="Chấm công">
                        <i class="fas fa-calendar-alt"></i>
                        <span class="text-cham-cong">Chấm công ngay</span>
                    </a>

                    <span class="separator-line">|</span>

                    <a href="#" class="user-name-text">Xin chào, Khánh Ngọc</a>

                </div>
            </nav>

            <div class="main-content-container">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>