@model IEnumerable<WEBPC_NHANVIEN.Models.DonHang>

@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Sale/Views/Shared/_LayoutSale.cshtml";
}

@section Styles {
    <style>
        .sale-order-layout {
            display: flex;
            height: calc(100vh - 100px);
            gap: 20px;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .col-detail-panel {
            flex: 5;
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: 1px solid #f0f0f0;
            overflow: hidden;
        }

        .col-list-panel {
            flex: 7;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            border: 1px solid #f0f0f0;
            overflow: hidden;
        }

        .panel-header {
            padding: 20px 24px;
            background: #fff;
            border-bottom: 1px solid #edf2f7;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .panel-header h5 {
                font-weight: 700;
                color: #32325d;
                font-size: 1.1rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .scroll-content {
            overflow-y: auto;
            flex: 1;
        }

        .table-custom {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .table-custom th {
                background-color: #44539c;
                color: #fff;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                font-weight: 700;
                padding: 16px 24px;
                position: sticky;
                top: 0;
                z-index: 10;
                border-bottom: 1px solid #e9ecef;
            }

            .table-custom td {
                padding: 16px 24px;
                vertical-align: middle;
                border-bottom: 1px solid #f0f3f5;
                color: #525f7f;
                font-size: 0.95rem;
                background: #e8e8e8;
                transition: all 0.2s;
                text-align: center;
            }

        .row-item {
            cursor: pointer;
        }

            .row-item:hover td {
                background-color: #f6f9fc;
                color: #32325d;
            }

            .row-item.active td {
                background-color: #e8f0fe !important;
                color: #0d47a1;
                font-weight: 600;
                border-bottom-color: #dbeafe;
            }

                .row-item.active td:first-child {
                    border-left: 4px solid #0d47a1;
                }

        .code-text {
            font-family: 'Consolas', monospace;
            font-weight: 700;
            color: #32325d;
        }

        .badge-status {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            min-width: 90px;
            text-align: center;
        }

        .st-new {
            background: #e3f2fd;
            color: #004085;
        }

        .st-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .st-cancel {
            background: #f8d7da;
            color: #842029;
        }

        .group-header {
            background-color: #f8f9fa;
            padding: 12px 20px;
            font-weight: 600;
            color: #495057;
            font-size: 0.9rem;
            border-bottom: 1px solid #edf2f7;
            border-top: 1px solid #edf2f7;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .group-products {
            flex: 2;
            display: flex;
            flex-direction: column;
        }

        .group-transaction {
            flex: 1.5;
            display: flex;
            flex-direction: column;
        }

        .group-summary {
            background-color: #fff;
            padding: 20px 24px;
            border-top: 1px solid #edf2f7;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.03);
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
        }

            .detail-table td {
                padding: 10px 15px;
                border-bottom: 1px dashed #eee;
                font-size: 0.9rem;
            }

            .detail-table th {
                padding: 10px 15px;
                font-size: 0.8rem;
                text-transform: uppercase;
                color: #8898aa;
                background: #fff;
                border-bottom: 2px solid #edf2f7;
            }

        .hidden {
            display: none !important;
        }

        .btn-reload {
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #64748b;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

            .btn-reload:hover {
                background: #f1f5f9;
                color: #0f172a;
                border-color: #cbd5e1;
            }

        .empty-state-box {
            background: #f8f9fa;
            padding: 30px;
            border-radius: 50%;
            margin-bottom: 20px;
        }

        /* Debug panel */
        .debug-panel {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #2d3748;
            color: #fff;
            padding: 15px;
            border-radius: 8px;
            max-width: 400px;
            font-family: 'Consolas', monospace;
            font-size: 0.85rem;
            z-index: 9999;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

            .debug-panel h6 {
                color: #48bb78;
                margin: 0 0 10px 0;
                font-size: 0.9rem;
            }

            .debug-panel .url-test {
                background: #1a202c;
                padding: 8px;
                border-radius: 4px;
                margin: 5px 0;
                cursor: pointer;
                transition: all 0.2s;
            }

                .debug-panel .url-test:hover {
                    background: #4a5568;
                }

            .debug-panel .status {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 4px;
                font-size: 0.75rem;
                margin-left: 10px;
            }

        .status-ok {
            background: #48bb78;
        }

        .status-error {
            background: #f56565;
        }

        .status-testing {
            background: #ed8936;
        }
    </style>
}

<div class="sale-order-layout">
    <div class="col-detail-panel">
        <div id="empty-state" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <div class="empty-state-box">
                <i class="fas fa-clipboard-check fa-3x" style="color: #cbd5e1;"></i>
            </div>
            <h6 style="color: #64748b;">Chưa chọn đơn hàng</h6>
            <p class="small">Vui lòng chọn một đơn từ danh sách bên phải</p>
        </div>

        <div id="detail-container" class="d-flex flex-column h-100 hidden">
            <div class="group-products">
                <div class="group-header">
                    <i class="fas fa-box text-primary"></i>
                    <span>Danh sách sản phẩm</span>
                </div>
                <div class="scroll-content">
                    <table class="detail-table">
                        <thead>
                            <tr>
                                <th>Tên SP</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="tbl-products"></tbody>
                    </table>
                </div>
            </div>

            <div class="group-transaction">
                <div class="group-header">
                    <i class="fas fa-wallet text-success"></i>
                    <span>Thanh toán & Giao dịch</span>
                    <span class="badge bg-light text-dark border ms-auto" id="lbl-payment-method">COD</span>
                </div>
                <div class="scroll-content">
                    <table class="detail-table">
                        <tbody id="tbl-transaction">
                            <tr><td class="text-muted">Mã Giao Dịch</td><td id="lbl-trans-code" class="fw-bold text-end">...</td></tr>
                            <tr><td class="text-muted">Thời gian</td><td id="lbl-trans-date" class="text-end">...</td></tr>
                            <tr><td class="text-muted">Số tiền</td><td id="lbl-trans-amount" class="text-success fw-bold text-end">...</td></tr>
                            <tr><td class="text-muted">Trạng thái</td><td id="lbl-trans-status" class="text-end">...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="group-summary">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Khách hàng:</span>
                    <strong id="lbl-customer-name" class="text-dark">...</strong>
                </div>
                <div class="d-flex justify-content-between mb-4 align-items-center">
                    <span style="font-size: 1.1rem; color: #495057;">Tổng thanh toán:</span>
                    <strong class="text-danger" style="font-size: 1.5rem;" id="lbl-total-money">0 đ</strong>
                </div>

                <div id="action-buttons" class="row g-3">
                    <div class="col-6">
                        <button class="btn btn-outline-danger w-100 py-2" onclick="processOrder(false)">
                            <i class="fas fa-times-circle me-1"></i> Hủy Đơn
                        </button>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-primary w-100 py-2 shadow-sm" onclick="processOrder(true)">
                            <i class="fas fa-check-circle me-1"></i> Duyệt Đơn
                        </button>
                    </div>
                </div>
                <div id="action-message" class="text-center fw-bold p-3 rounded-3 hidden" style="font-size: 0.95rem;"></div>
            </div>
        </div>
    </div>

    <div class="col-list-panel">
        <div class="panel-header">
            <h5><i class="fas fa-list-ul text-primary"></i> Danh Sách Đơn Hàng</h5>
            <button class="btn-reload" onclick="testAllUrls()" title="Test URLs">
                <i class="fas fa-bug"></i> Test API
            </button>
            <button class="btn-reload" onclick="location.reload()" title="Tải lại dữ liệu">
                <i class="fas fa-sync-alt"></i> Tải lại
            </button>
        </div>

        <div class="scroll-content flex-grow-1">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="padding-left: 30px;">Mã Đơn</th>
                        <th>Ngày Đặt</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody id="tbl-orders">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string badge = "st-new";
                            if (item.trangThai == "Đã duyệt" || item.trangThai == "Hoàn thành") { badge = "st-ok"; }
                            else if (item.trangThai != null && item.trangThai.Contains("hủy")) { badge = "st-cancel"; }

                            <tr class="row-item" onclick="viewDetail(this, @item.maDonHang)">
                                <td style="padding-left: 30px;">
                                    <span class="code-text">@(item.maCodeDonHang ?? "---")</span>
                                </td>
                                <td>
                                    <div class="text-muted small"><i class="far fa-clock me-1"></i> @(item.ngayDat.ToString("HH:mm"))</div>
                                    <div class="fw-bold" style="color: #32325d;">@(item.ngayDat.ToString("dd/MM/yyyy"))</div>
                                </td>
                                <td><span class="badge-status @badge">@item.trangThai</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="64" style="opacity:0.5; margin-bottom:10px;" />
                                <div class="text-muted">Không có đơn hàng nào</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- DEBUG PANEL -->
<div id="debug-panel" class="debug-panel" style="display: none;">
    <h6>🔍 API URL Test Results</h6>
    <div id="debug-results"></div>
    <button onclick="document.getElementById('debug-panel').style.display='none'" style="margin-top:10px; padding:5px 10px; background:#f56565; border:none; border-radius:4px; color:#fff; cursor:pointer;">
        Close
    </button>
</div>

@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════════
        // CẤU HÌNH API - THỬ TẤT CẢ CÁC ĐƯỜNG DẪN CÓ THỂ
        // ═══════════════════════════════════════════════════════════════
        const API_VARIATIONS = {
            list: [
                '/Sale/DonHang/GetList',
                '/Sale/DonHang/GetDanhSach',
                '/Sale/DonHang/DanhSach',
                '/Sale/DonHang/Index',
                '/Sale/DonHang',
                '@Url.Action("GetList", "DonHang", new { area = "Sale" })',
                '@Url.Action("Index", "DonHang", new { area = "Sale" })'
            ],
            detail: [
                '/Sale/DonHang/GetDetail',
                '/Sale/DonHang/ChiTiet',
                '/Sale/DonHang/Detail',
                '@Url.Action("GetDetail", "DonHang", new { area = "Sale" })',
                '@Url.Action("ChiTiet", "DonHang", new { area = "Sale" })'
            ]
        };

        let API_LIST_URL = '/Sale/DonHang/GetList';
        let API_DETAIL_URL = '/Sale/DonHang/GetDetail';
        const API_ACTION_URL = '/Sale/DonHang';

        let selectedOrderId = null;

        // ═══════════════════════════════════════════════════════════════
        // HÀM TEST TẤT CẢ URL
        // ═══════════════════════════════════════════════════════════════
        async function testAllUrls() {
            const panel = document.getElementById('debug-panel');
            const results = document.getElementById('debug-results');
            panel.style.display = 'block';
            results.innerHTML = '<div style="text-align:center;"><i class="fas fa-spinner fa-spin"></i> Testing...</div>';

            const testResults = [];

            // Test List URLs
            console.log("🧪 Testing LIST URLs...");
            for (const url of API_VARIATIONS.list) {
                try {
                    const res = await fetch(url);
                    const status = res.status;
                    const isOk = res.ok;

                    testResults.push({
                        type: 'LIST',
                        url: url,
                        status: status,
                        ok: isOk
                    });

                    if (isOk) {
                        API_LIST_URL = url;
                        console.log("✅ Found working LIST URL:", url);
                    }
                } catch (e) {
                    testResults.push({
                        type: 'LIST',
                        url: url,
                        status: 'ERROR',
                        ok: false,
                        error: e.message
                    });
                }
            }

            // Test Detail URLs (với ID mẫu)
            const testId = @(Model != null && Model.Any() ? Model.First().maDonHang : 1);
            console.log("🧪 Testing DETAIL URLs with ID:", testId);

            for (const url of API_VARIATIONS.detail) {
                try {
                    const fullUrl = `${url}/${testId}`;
                    const res = await fetch(fullUrl);
                    const status = res.status;
                    const isOk = res.ok;

                    testResults.push({
                        type: 'DETAIL',
                        url: fullUrl,
                        status: status,
                        ok: isOk
                    });

                    if (isOk) {
                        API_DETAIL_URL = url;
                        console.log("✅ Found working DETAIL URL:", url);
                    }
                } catch (e) {
                    testResults.push({
                        type: 'DETAIL',
                        url: url,
                        status: 'ERROR',
                        ok: false,
                        error: e.message
                    });
                }
            }

            // Display results
            let html = '';
            testResults.forEach(r => {
                const statusClass = r.ok ? 'status-ok' : 'status-error';
                const statusText = r.ok ? '✓ ' + r.status : '✗ ' + r.status;
                html += `
                    <div class="url-test">
                        <strong>${r.type}:</strong> ${r.url}
                        <span class="status ${statusClass}">${statusText}</span>
                        ${r.error ? `<br><small style="color:#f56565;">Error: ${r.error}</small>` : ''}
                    </div>
                `;
            });

            // Add working URLs
            const workingList = testResults.find(r => r.type === 'LIST' && r.ok);
            const workingDetail = testResults.find(r => r.type === 'DETAIL' && r.ok);

            if (workingList || workingDetail) {
                html += '<hr style="border-color:#4a5568; margin:10px 0;">';
                html += '<div style="color:#48bb78;"><strong>✅ Working URLs Found:</strong></div>';
                if (workingList) html += `<div>LIST: <code>${workingList.url}</code></div>`;
                if (workingDetail) html += `<div>DETAIL: <code>${workingDetail.url.replace(/\/\d+$/, '/{id}')}</code></div>`;

                html += '<button onclick="loadOrders()" style="margin-top:10px; padding:5px 10px; background:#48bb78; border:none; border-radius:4px; color:#fff; cursor:pointer;">Reload with correct URLs</button>';
            } else {
                html += '<hr style="border-color:#4a5568; margin:10px 0;">';
                html += '<div style="color:#f56565;"><strong>❌ No working URLs found!</strong></div>';
                html += '<div style="margin-top:10px; font-size:0.8rem;">Please check your Controller actions exist.</div>';
            }

            results.innerHTML = html;
        }

        // ═══════════════════════════════════════════════════════════════
        // KHỞI TẠO
        // ═══════════════════════════════════════════════════════════════
        window.addEventListener('DOMContentLoaded', function() {
            console.log("✅ App khởi động");
            // Không gọi loadOrders() ngay, để user bấm nút Test API trước
        });

        // ═══════════════════════════════════════════════════════════════
        // HÀM TẢI DANH SÁCH
        // ═══════════════════════════════════════════════════════════════
        async function loadOrders() {
            const tbody = document.getElementById('tbl-orders');
            tbody.innerHTML = '<tr><td colspan="3" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>';

            console.log("📡 Đang gọi API:", API_LIST_URL);

            try {
                const res = await fetch(API_LIST_URL);
                console.log("📥 Response status:", res.status);

                if (!res.ok) throw new Error("Lỗi HTTP: " + res.status);

                const data = await res.json();
                console.log("📦 Dữ liệu danh sách:", data);

                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-center py-3">Danh sách trống.</td></tr>';
                    return;
                }

                data.forEach((item, index) => {
                    if (index === 0) console.log("🔍 Dòng đầu tiên:", item);

                    const id = item.maDonHang || item.MaDonHang || item.id || item.Id;
                    const code = item.maCodeDonHang || item.MaCodeDonHang || item.MaCode || item.code || '---';

                    const rawDate = item.ngayDat || item.NgayDat || item.createdDate;
                    let dateDisplay = '---';
                    if (rawDate) {
                        if (typeof rawDate === 'string' && rawDate.includes('/Date(')) {
                            const timestamp = parseInt(rawDate.replace(/\/Date\((\d+)\)\//, '$1'));
                            dateDisplay = new Date(timestamp).toLocaleString('vi-VN');
                        } else {
                            dateDisplay = new Date(rawDate).toLocaleString('vi-VN');
                        }
                    }

                    let rawStatus = item.trangThai ?? item.TrangThai ?? item.status ?? item.Status ?? item.tinhTrang;
                    if (rawStatus === undefined || rawStatus === null) rawStatus = '---';

                    let badge = 'st-new';
                    const stStr = String(rawStatus).toLowerCase();

                    if (stStr.includes('duyệt') || stStr.includes('hoàn thành') || stStr.includes('thành công') || stStr == '1') badge = 'st-ok';
                    if (stStr.includes('hủy') || stStr.includes('fail') || stStr == '-1') badge = 'st-cancel';

                    tbody.insertAdjacentHTML('beforeend', `
                        <tr class="row-item" onclick="viewDetail(this, ${id})">
                            <td style="padding-left: 30px;"><span class="code-text">${code}</span></td>
                            <td>${dateDisplay}</td>
                            <td><span class="badge-status ${badge}">${rawStatus}</span></td>
                        </tr>
                    `);
                });

            } catch (e) {
                console.error("❌ Lỗi LoadOrders:", e);
                tbody.innerHTML = `<tr><td colspan="3" class="text-center text-danger">Lỗi: ${e.message}<br><br><button onclick="testAllUrls()" class="btn btn-sm btn-warning">🔍 Test API URLs</button></td></tr>`;
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // HÀM XEM CHI TIẾT
        // ═══════════════════════════════════════════════════════════════
        async function viewDetail(rowElem, id) {
            document.querySelectorAll('.row-item').forEach(r => r.classList.remove('active'));
            rowElem.classList.add('active');

            document.getElementById('empty-state').classList.add('hidden');
            document.getElementById('detail-container').classList.remove('hidden');

            selectedOrderId = id;

            try {
                const apiUrl = `${API_DETAIL_URL}/${id}`;
                console.log("📡 API URL:", apiUrl);

                const res = await fetch(apiUrl);
                if (!res.ok) throw new Error("Lỗi API: " + res.status);

                const detail = await res.json();
                console.log("📦 Chi tiết:", detail);

                // Render sản phẩm
                const listSP = detail.chiTiet || detail.ChiTiet || detail.chiTietDonHang || [];
                const tblProd = document.getElementById('tbl-products');
                tblProd.innerHTML = '';

                if (listSP.length > 0) {
                    listSP.forEach(sp => {
                        const ten = sp.tenSanPham || sp.TenSanPham || '---';
                        const sl = sp.soLuong || sp.SoLuong || 0;
                        const dg = sp.donGiaLucMua || sp.DonGiaLucMua || 0;
                        const tt = sp.thanhTien || sp.ThanhTien || (sl * dg);

                        tblProd.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td class="fw-bold text-dark">${ten}</td>
                                <td class="text-center">${sl}</td>
                                <td class="text-end">${fmt(dg)}</td>
                                <td class="text-end fw-bold text-primary">${fmt(tt)}</td>
                            </tr>
                        `);
                    });
                } else {
                    tblProd.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Không có sản phẩm</td></tr>';
                }

                // Phần còn lại giữ nguyên...
                document.getElementById('lbl-customer-name').textContent = detail.nguoiNhan || 'Khách lẻ';
                document.getElementById('lbl-total-money').textContent = fmt(detail.tongTien || 0);

            } catch (e) {
                console.error("❌ Lỗi:", e);
                alert("Lỗi: " + e.message);
            }
        }

        async function processOrder(isApprove) {
            if (!selectedOrderId) return alert("Chưa chọn đơn!");
            const action = isApprove ? 'DuyetDon' : 'HuyDon';
            if (!confirm(`Xác nhận ${isApprove ? 'DUYỆT' : 'HỦY'}?`)) return;

            try {
                const res = await fetch(`${API_ACTION_URL}/${action}/${selectedOrderId}`, { method: 'POST' });
                const rs = await res.json();
                if (rs.success) {
                    alert("Thành công!");
                    location.reload();
                } else {
                    alert("Lỗi: " + rs.msg);
                }
            } catch (e) {
                alert("Lỗi hệ thống!");
            }
        }

        function fmt(n) {
            if (!n) return '0 đ';
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
        }
    </script>
}
