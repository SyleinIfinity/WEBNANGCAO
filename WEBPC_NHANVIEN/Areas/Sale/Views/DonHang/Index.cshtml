@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Sale/Views/Shared/_LayoutSale.cshtml";
}

@section Styles {
    <style>
        /* --- LAYOUT 2 CỘT CHUYÊN NGHIỆP --- */
        .sale-order-layout {
            display: flex;
            height: calc(100vh - 100px);
            gap: 20px;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 20px;
            background-color: #f1f5f9; /* Nền xám nhẹ */
        }

        /* --- CỘT TRÁI (CHI TIẾT) - Flex 5 --- */
        .col-detail-panel {
            flex: 5;
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            height: 100%;
        }

        /* --- CỘT PHẢI (DANH SÁCH) - Flex 7 --- */
        .col-list-panel {
            flex: 7;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            height: 100%;
        }

        /* --- HEADER --- */
        .panel-header {
            padding: 20px 24px;
            background: #fff;
            border-bottom: 1px solid #edf2f7;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .panel-header h5 {
                font-weight: 700;
                color: #1e293b;
                font-size: 1.1rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        /* --- SCROLL CONTENT --- */
        .scroll-content {
            overflow-y: auto;
            flex: 1;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f1f5f9;
        }

            .scroll-content::-webkit-scrollbar {
                width: 6px;
            }

            .scroll-content::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            .scroll-content::-webkit-scrollbar-thumb {
                background-color: #cbd5e1;
                border-radius: 20px;
            }

        /* --- TABLE --- */
        .table-custom {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .table-custom th {
                background-color: #f8fafc;
                color: #64748b;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                font-weight: 700;
                padding: 16px 24px;
                position: sticky;
                top: 0;
                z-index: 10;
                border-bottom: 1px solid #e2e8f0;
            }

            .table-custom td {
                padding: 12px 24px; /* Giảm padding một chút cho gọn */
                vertical-align: middle;
                border-bottom: 1px solid #f1f5f9;
                color: #334155;
                font-size: 0.9rem;
                transition: all 0.2s;
            }

        .row-item {
            cursor: pointer;
            transition: 0.2s;
        }

            .row-item:hover td {
                background-color: #f8fafc;
            }

            .row-item.active td {
                background-color: #eff6ff !important;
                color: #2563eb;
            }

                .row-item.active td:first-child {
                    border-left: 4px solid #2563eb;
                }

        .code-text {
            font-family: 'Consolas', monospace;
            font-weight: 700;
            color: #475569;
        }

        /* --- BADGES --- */
        .badge-status {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            min-width: 90px;
            text-align: center;
        }

        .st-new {
            background: #e0f2fe;
            color: #0284c7;
        }
        /* Xanh dương nhạt */
        .st-ok {
            background: #dcfce7;
            color: #16a34a;
        }
        /* Xanh lá */
        .st-cancel {
            background: #fee2e2;
            color: #dc2626;
        }
        /* Đỏ */

        /* --- CHI TIẾT ĐƠN HÀNG (CỘT TRÁI) --- */
        .group-header {
            background-color: #f8fafc;
            padding: 12px 20px;
            font-weight: 600;
            color: #475569;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid #e2e8f0;
            border-top: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Sản phẩm */
        .product-item {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            border-bottom: 1px solid #f1f5f9;
            gap: 15px;
        }

        .product-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .product-info {
            flex: 1;
        }

        .product-name {
            font-weight: 600;
            color: #1e293b;
            font-size: 0.9rem;
            margin-bottom: 2px;
        }

        .product-meta {
            color: #64748b;
            font-size: 0.8rem;
        }

        .product-price {
            font-weight: 700;
            color: #2563eb;
        }

        /* Thông tin thanh toán */
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 20px;
            border-bottom: 1px dashed #e2e8f0;
            font-size: 0.9rem;
        }

        .info-label {
            color: #64748b;
        }

        .info-value {
            color: #1e293b;
            font-weight: 600;
            text-align: right;
        }

        /* Tổng kết & Hành động */
        .group-summary {
            padding: 20px;
            background: #fff;
            border-top: 1px solid #e2e8f0;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .total-price {
            font-size: 1.5rem;
            font-weight: 800;
            color: #dc2626;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-cancel {
            background: #fee2e2;
            color: #dc2626;
        }

            .btn-cancel:hover {
                background: #fecaca;
            }

        .btn-approve {
            background: #2563eb;
            color: #fff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

            .btn-approve:hover {
                background: #1d4ed8;
                transform: translateY(-2px);
            }

        .hidden {
            display: none !important;
        }

        .loading-spinner {
            text-align: center;
            padding: 30px;
            color: #64748b;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #94a3b8;
        }
    </style>
}

<div class="sale-order-layout">
    <div class="col-detail-panel">
        <div id="detail-loading" class="loading-spinner hidden">
            <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
            <p>Đang tải thông tin chi tiết...</p>
        </div>

        <div id="empty-state" class="empty-state h-100 d-flex flex-column justify-content-center">
            <i class="fas fa-file-invoice fa-4x mb-3" style="opacity: 0.3;"></i>
            <h6>Chưa chọn đơn hàng</h6>
            <p class="small">Vui lòng chọn một đơn hàng từ danh sách bên phải</p>
        </div>

        <div id="detail-content" class="d-flex flex-column h-100 hidden">
            <div style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
                <div class="group-header">
                    <span><i class="fas fa-box text-primary me-2"></i> Sản phẩm</span>
                </div>
                <div class="scroll-content" id="product-list">
                </div>
            </div>

            <div style="height: 35%; display: flex; flex-direction: column; min-height: 200px; border-top: 1px solid #e2e8f0;">
                <div class="group-header">
                    <span><i class="fas fa-wallet text-success me-2"></i> Thanh toán & Giao nhận</span>
                    <span id="lbl-payment-method" class="badge bg-light text-dark border">COD</span>
                </div>
                <div class="scroll-content" id="payment-info">
                </div>
            </div>

            <div class="group-summary">
                <div class="total-row">
                    <span class="text-muted">Tổng thanh toán:</span>
                    <span class="total-price" id="lbl-total-price">0 đ</span>
                </div>

                <div id="action-buttons" class="action-buttons hidden">
                    <button class="btn-action btn-cancel" onclick="processOrder(false)">
                        <i class="fas fa-times-circle"></i> Hủy Đơn
                    </button>
                    <button class="btn-action btn-approve" onclick="processOrder(true)">
                        <i class="fas fa-check-circle"></i> Duyệt Đơn
                    </button>
                </div>

                <div id="status-alert" class="alert alert-light text-center mb-0 border hidden" style="background: #f8fafc; font-size: 0.9rem;">
                    <i class="fas fa-info-circle me-1"></i> <span id="lbl-status-text">...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-list-panel">
        <div class="panel-header">
            <h5><i class="fas fa-list-ul text-primary me-2"></i> Danh Sách Đơn Hàng</h5>
            <button class="btn btn-sm btn-white border" onclick="loadOrderList()" title="Tải lại">
                <i class="fas fa-sync-alt text-muted"></i>
            </button>
        </div>

        <div class="scroll-content">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="padding-left: 30px;">Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody id="tbl-orders">
                </tbody>
            </table>

            <div id="list-loading" class="loading-spinner">
                <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                <p>Đang tải dữ liệu...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- CẤU HÌNH API (Dùng Url.Action để fix lỗi deploy thư mục con) ---
        const URL_GET_LIST = '@Url.Action("GetList", "DonHang", new { area = "Sale" })';
        const URL_GET_DETAIL = '@Url.Action("GetDetail", "DonHang", new { area = "Sale" })';
        const URL_ACTION = '@Url.Action("", "DonHang", new { area = "Sale" })'; // Base cho Duyet/Huy

        let currentOrderId = 0;

        // --- INIT ---
        document.addEventListener('DOMContentLoaded', function() {
            loadOrderList();
        });

        // --- 1. LOAD DANH SÁCH ---
        async function loadOrderList() {
            const tbody = document.getElementById('tbl-orders');
            const loader = document.getElementById('list-loading');

            tbody.innerHTML = '';
            loader.classList.remove('hidden');

            try {
                const res = await fetch(URL_GET_LIST);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = await res.json();
                loader.classList.add('hidden');

                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-5 text-muted">Không có đơn hàng nào</td></tr>';
                    return;
                }

                data.forEach(item => {
                    // Badge logic
                    let badgeClass = 'st-new';
                    const st = (item.trangThai || '').toLowerCase();
                    if (st.includes('duyệt') || st.includes('giao') || st.includes('hoàn')) badgeClass = 'st-ok';
                    if (st.includes('hủy') || st.includes('fail')) badgeClass = 'st-cancel';

                    // --- [SỬA LẠI]: HIỂN THỊ CẢ GIỜ VÀ NGÀY ---
                    let timeStr = '';
                    let dayStr = '---';
                    if (item.ngayDat) {
                        const dateVal = item.ngayDat.toString().replace(/\/Date\((\d+)\)\//, '$1');
                        const d = new Date(parseInt(dateVal) || item.ngayDat);

                        // Lấy giờ phút (Ví dụ: 14:30)
                        timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false });
                        // Lấy ngày tháng (Ví dụ: 20/12/2024)
                        dayStr = d.toLocaleDateString('vi-VN');
                    }

                    const html = `
                        <tr class="row-item" onclick="loadOrderDetail(this, ${item.maDonHang})">
                            <td style="padding-left: 30px;"><span class="code-text">${item.maCodeDonHang || '---'}</span></td>
                            <td class="fw-bold text-dark">${item.nguoiNhan || 'Khách lẻ'}</td>
                            <td>
                                <div class="small text-muted" style="font-size: 0.75rem;"><i class="far fa-clock"></i> ${timeStr}</div>
                                <div class="fw-bold text-dark">${dayStr}</div>
                            </td>
                            <td class="text-center"><span class="badge-status ${badgeClass}">${item.trangThai}</span></td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', html);
                });

            } catch (err) {
                loader.innerHTML = `<span class="text-danger">Lỗi tải dữ liệu: ${err.message}</span>`;
            }
        }

        // --- 2. LOAD CHI TIẾT ---
        async function loadOrderDetail(row, id) {
            // Active row effect
            document.querySelectorAll('.row-item').forEach(r => r.classList.remove('active'));
            row.classList.add('active');

            // Toggle UI
            document.getElementById('empty-state').classList.add('hidden');
            document.getElementById('detail-content').classList.add('hidden');
            document.getElementById('detail-loading').classList.remove('hidden');

            currentOrderId = id;

            try {
                const res = await fetch(`${URL_GET_DETAIL}/${id}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = await res.json();

                renderDetail(data);

                document.getElementById('detail-loading').classList.add('hidden');
                document.getElementById('detail-content').classList.remove('hidden');

            } catch (err) {
                document.getElementById('detail-loading').innerHTML = `<div class="text-danger p-4">Không thể tải chi tiết: ${err.message}</div>`;
            }
        }

        // --- 3. RENDER UI ---
        function renderDetail(data) {
            // A. Sản phẩm
            const listContainer = document.getElementById('product-list');
            listContainer.innerHTML = '';
            const products = data.chiTiet || data.ChiTiet || [];

            if (products.length > 0) {
                products.forEach(p => {
                    const img = p.hinhAnh || p.HinhAnh || 'https://via.placeholder.com/60';
                    const html = `
                        <div class="product-item">
                            <img src="${img}" class="product-img">
                            <div class="product-info">
                                <div class="product-name">${p.tenSanPham || p.TenSanPham}</div>
                                <div class="product-meta">Số lượng: <span class="text-dark fw-bold">${p.soLuong}</span></div>
                            </div>
                            <div class="product-price">${fmt(p.thanhTien)}</div>
                        </div>
                    `;
                    listContainer.insertAdjacentHTML('beforeend', html);
                });
            } else {
                listContainer.innerHTML = '<div class="text-center py-4 text-muted">Không có sản phẩm</div>';
            }

            // B. Thanh toán Info
            const paymentContainer = document.getElementById('payment-info');
            const method = data.phuongThucThanhToan || 'COD';

            // Badge Payment Method
            const lblMethod = document.getElementById('lbl-payment-method');
            lblMethod.textContent = method;
            lblMethod.className = method === 'VietQR' ? 'badge bg-success text-white' : 'badge bg-light text-dark border';

            let infoHtml = `
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-user me-2"></i>Người nhận</span>
                    <span class="info-value">${data.nguoiNhan || '---'}</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-phone me-2"></i>SĐT</span>
                    <span class="info-value">${data.soDienThoaiGiao || '---'}</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ</span>
                    <span class="info-value text-break" style="max-width: 60%;">${data.diaChiGiaoHang || '---'}</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-shipping-fast me-2"></i>Phí vận chuyển</span>
                    <span class="info-value text-primary">${fmt(data.phiVanChuyen)}</span>
                </div>
            `;

            // Nếu VietQR -> Thêm thông tin GD
            if (method === 'VietQR') {
                const trans = (data.giaoDichs || [])[0];
                if (trans) {
                    const sttColor = trans.trangThai === 'Success' ? 'text-success' : 'text-danger';
                    infoHtml += `
                        <div class="bg-light p-2 mx-3 mt-2 rounded border" style="font-size: 0.85rem;">
                            <div class="fw-bold text-muted mb-1">GIAO DỊCH VIETQR</div>
                            <div class="d-flex justify-content-between"><span>Mã GD:</span> <span class="fw-bold">${trans.maGiaoDich}</span></div>
                            <div class="d-flex justify-content-between"><span>Số tiền:</span> <span class="fw-bold">${fmt(trans.soTien)}</span></div>
                            <div class="d-flex justify-content-between"><span>Trạng thái:</span> <span class="${sttColor} fw-bold">${trans.trangThai}</span></div>
                        </div>
                    `;
                }
            }
            paymentContainer.innerHTML = infoHtml;

            // C. Footer Action
            document.getElementById('lbl-total-price').textContent = fmt(data.tongTien);

            const status = (data.trangThai || '').toLowerCase();
            const btnBox = document.getElementById('action-buttons');
            const alertBox = document.getElementById('status-alert');
            const lblAlert = document.getElementById('lbl-status-text');

            // Logic ẩn hiện nút: Chỉ hiện khi Chờ xác nhận/Chờ thanh toán
            if (status.includes('chờ') || status.includes('cho') || status === 'choxacnhan') {
                btnBox.classList.remove('hidden');
                alertBox.classList.add('hidden');
            }
            // Hoặc đã thanh toán online (chỉ duyệt, không hủy - tùy logic em)
            else if (status.includes('thanhtoan')) {
                btnBox.classList.remove('hidden');
                alertBox.classList.add('hidden');
            }
            else {
                btnBox.classList.add('hidden');
                alertBox.classList.remove('hidden');

                if (status.includes('hủy')) {
                    alertBox.style.color = '#dc2626';
                    lblAlert.textContent = 'Đơn hàng đã bị hủy';
                } else if (status.includes('giao') || status.includes('hoàn')) {
                    alertBox.style.color = '#16a34a';
                    lblAlert.textContent = 'Đơn hàng đã được duyệt/hoàn thành';
                } else {
                    alertBox.style.color = '#475569';
                    lblAlert.textContent = `Trạng thái: ${data.trangThai}`;
                }
            }
        }

        // --- 4. XỬ LÝ DUYỆT/HỦY ---
        async function processOrder(isApprove) {
            if (!currentOrderId) return;

            const actionName = isApprove ? 'Duyệt' : 'Hủy';
            const actionUrl = isApprove ? 'DuyetDon' : 'HuyDon';

            if (!confirm(`Bạn chắc chắn muốn ${actionName} đơn hàng này?`)) return;

            // Loading UI nút bấm
            const btnArea = document.getElementById('action-buttons');
            const oldHtml = btnArea.innerHTML;
            btnArea.innerHTML = '<div class="text-center text-primary py-2"><i class="fas fa-spinner fa-spin"></i> Đang xử lý...</div>';

            try {
                const url = `${URL_ACTION}/${actionUrl}/${currentOrderId}`;
                const res = await fetch(url, { method: 'POST' });
                const json = await res.json();

                if (json.success) {
                    alert(`${actionName} thành công!`);
                    loadOrderList(); // Reload list
                    // Reset detail panel
                    document.getElementById('detail-content').classList.add('hidden');
                    document.getElementById('empty-state').classList.remove('hidden');
                } else {
                    alert(`Lỗi: ${json.msg}`);
                    btnArea.innerHTML = oldHtml;
                }
            } catch (err) {
                alert(`Lỗi hệ thống: ${err.message}`);
                btnArea.innerHTML = oldHtml;
            }
        }

        function fmt(n) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n || 0);
        }
    </script>
}