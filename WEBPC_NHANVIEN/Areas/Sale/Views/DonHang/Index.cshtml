@model IEnumerable<WEBPC_NHANVIEN.Models.DonHang>

@{
    ViewBag.Title = "Quản lý Đơn Hàng";
    Layout = "~/Areas/Sale/Views/Shared/_LayoutSale.cshtml";
}

<style>
    /* ================================================================= */
    /* MODAL BACKDROP - ĐỔ BÓNG ĐÈ TOÀN MÀN HÌNH */
    /* ================================================================= */
    .custom-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.75);
        z-index: 9998;
        animation: fadeIn 0.3s ease;
    }

    .custom-backdrop.show {
        display: block;
    }

    /* Modal Container */
    .custom-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        overflow-y: auto;
        animation: fadeIn 0.3s ease;
    }

    .custom-modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content-wrapper {
        position: relative;
        max-width: 420px;
        width: 90%;
        margin: 20px;
        animation: slideDown 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================================================================= */
    /* ORDER CARD STYLING - THIẾT KẾ MỚI */
    /* ================================================================= */
    .order-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .order-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        overflow: hidden;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

    .order-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(46, 204, 113, 0.2);
        border-color: #2ecc71;
    }

    .order-card-header {
        background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
        padding: 16px 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .order-code {
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .order-status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        background: rgba(255,255,255,0.25);
        backdrop-filter: blur(10px);
    }

    .order-card-body {
        padding: 20px;
    }

    .order-info-row {
        display: flex;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .order-info-row:last-child {
        border-bottom: none;
    }

    .order-info-icon {
        width: 36px;
        height: 36px;
        background: #f8f9fa;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2ecc71;
        font-size: 1rem;
        margin-right: 12px;
    }

    .order-info-content {
        flex: 1;
    }

    .order-info-label {
        font-size: 0.75rem;
        color: #888;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .order-info-value {
        font-size: 0.95rem;
        color: #333;
        font-weight: 700;
    }

    .order-info-value.price {
        color: #2ecc71;
        font-size: 1.2rem;
    }

    .order-card-footer {
        padding: 16px 20px;
        background: #f8f9fa;
        display: flex;
        justify-content: center;
        gap: 12px;
        border-top: 1px solid #e9ecef;
    }

    .btn-action {
        flex: 1;
        padding: 10px 16px;
        border: none;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-action.view {
        background: #3498db;
        color: white;
    }

    .btn-action.view:hover {
        background: #2980b9;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

    .btn-action.approve {
        background: #2ecc71;
        color: white;
    }

    .btn-action.approve:hover {
        background: #27ae60;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
    }

    .btn-action.reject {
        background: #e74c3c;
        color: white;
    }

    .btn-action.reject:hover {
        background: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
    }

    /* ================================================================= */
    /* MODAL DETAIL STYLING - MÀU XANH */
    /* ================================================================= */
    .detail-modal-card {
        background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
        border-radius: 20px;
        padding: 0;
        color: white;
        box-shadow: 0 10px 40px rgba(46, 204, 113, 0.4);
        overflow: hidden;
        position: relative;
    }

    .detail-modal-header {
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,0.2);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-modal-header h5 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .detail-modal-header .btn-close-custom {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 1.1rem;
    }

    .detail-modal-header .btn-close-custom:hover {
        background: rgba(255,255,255,0.3);
        transform: rotate(90deg);
    }

    .detail-modal-body {
        padding: 24px 22px;
        text-align: center;
    }

    .discount-badge {
        font-size: 3rem;
        font-weight: 900;
        color: white;
        line-height: 1;
        margin-bottom: 8px;
        text-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    .discount-subtitle {
        font-size: 0.8rem;
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 4px;
    }

    .modal-order-code {
        font-size: 1rem;
        font-weight: 700;
        background: rgba(255,255,255,0.2);
        padding: 6px 14px;
        border-radius: 8px;
        display: inline-block;
        margin-top: 8px;
    }

    .detail-section {
        background: white;
        color: #333;
        padding: 20px;
        margin-top: 16px;
        border-radius: 16px 16px 0 0;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px dashed #e9ecef;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-size: 0.8rem;
        color: #666;
        font-weight: 600;
    }

    .detail-value {
        font-size: 0.85rem;
        color: #333;
        font-weight: 700;
        text-align: right;
    }

    .detail-value.full-width {
        text-align: left;
        width: 100%;
        margin-top: 5px;
    }

    .order-info-section {
        background: #f8f9fa;
        padding: 14px;
        border-radius: 12px;
        margin-top: 14px;
    }

    .order-info-section h6 {
        font-size: 0.85rem;
        color: #2ecc71;
        font-weight: 700;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .status-badge-large {
        display: inline-block;
        padding: 6px 18px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.8rem;
        margin-top: 12px;
    }

    /* Toast Notification */
    .toast-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        background: white;
        padding: 16px 24px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        z-index: 10000;
        display: none;
        min-width: 300px;
        animation: slideInRight 0.3s ease;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(400px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast-notification.show {
        display: block;
    }

    .toast-notification.success {
        border-left: 4px solid #2ecc71;
    }

    .toast-notification.error {
        border-left: 4px solid #e74c3c;
    }

    .toast-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .toast-icon {
        font-size: 1.5rem;
    }

    .toast-message {
        flex: 1;
    }

    .toast-title {
        font-weight: 700;
        margin-bottom: 4px;
        font-size: 0.95rem;
    }

    .toast-text {
        font-size: 0.85rem;
        color: #666;
    }

    /* Header Actions */
    .btn-manual-order {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-manual-order:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(46, 204, 113, 0.4);
    }

    .btn-refresh {
        background: white;
        color: #2ecc71;
        border: 2px solid #2ecc71;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-refresh:hover {
        background: #2ecc71;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-3">
       
        <button class="btn-manual-order">
            <i class="fas fa-plus-circle"></i> Đặt thủ công
        </button>
    </div>
</div>

<div class="order-container">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-code">#@item.maCodeDonHang</div>
                    <div class="order-status-badge">
                        @if (item.trangThai == "Completed")
                        {
                            <span>✓ Hoàn thành</span>
                        }
                        else if (item.trangThai == "ChoXacNhan")
                        {
                            <span>⏱ Chờ duyệt</span>
                        }
                        else if (item.trangThai == "Rejected" || item.trangThai == "Đã từ chối")
                        {
                            <span>✗ Đã từ chối</span>
                        }
                        else
                        {
                            <span>@item.trangThai</span>
                        }
                    </div>
                </div>

                <div class="order-card-body">
                    <div class="order-info-row">
                        <div class="order-info-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="order-info-content">
                            <div class="order-info-label">Khách hàng</div>
                            <div class="order-info-value">@item.tenKhachHang</div>
                        </div>
                    </div>

                    <div class="order-info-row">
                        <div class="order-info-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="order-info-content">
                            <div class="order-info-label">Ngày đặt</div>
                            <div class="order-info-value">@item.ngayDat.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <div class="order-info-row">
                        <div class="order-info-icon">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div class="order-info-content">
                            <div class="order-info-label">Tổng tiền</div>
                            <div class="order-info-value price">@item.tongTien.ToString("N0")₫</div>
                        </div>
                    </div>
                </div>

                <div class="order-card-footer">
                    <button class="btn-action view btn-view-order"
                            data-id="@item.maDonHang"
                            data-code="@item.maCodeDonHang"
                            data-customer="@item.nguoiNhan"
                            data-total="@item.tongTien"
                            data-status="@item.trangThai"
                            data-date="@item.ngayDat.ToString("dd/MM/yyyy HH:mm")"
                            data-fee="@item.phiVanChuyen"
                            data-address="@item.diaChiGiaoHang"
                            data-phone="@item.soDienThoaiGiao">
                        <i class="fas fa-eye"></i> Xem
                    </button>

                    @if (item.trangThai == "ChoXacNhan")
                    {
                        <button class="btn-action approve btn-approve" data-id="@item.maDonHang" data-code="@item.maCodeDonHang">
                            <i class="fas fa-check"></i> Duyệt
                        </button>
                    }

                    @if (item.trangThai != "Rejected" && item.trangThai != "Đã từ chối" && item.trangThai != "Completed")
                    {
                        <button class="btn-action reject btn-reject" data-id="@item.maDonHang" data-code="@item.maCodeDonHang">
                            <i class="fas fa-times"></i> Từ chối
                        </button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 w-100 text-muted">
            <i class="fas fa-inbox fa-3x mb-3"></i>
            <p>Không tìm thấy đơn hàng nào.</p>
        </div>
    }
</div>

<!-- Custom Modal -->
<div class="custom-backdrop" id="orderBackdrop"></div>
<div class="custom-modal" id="detailOrderModal">
    <div class="modal-content-wrapper">
        <div class="detail-modal-card">
            <div class="detail-modal-header">
                <h5>Chi tiết đơn hàng</h5>
                <button class="btn-close-custom" id="btnCloseModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="detail-modal-body">
                <div class="discount-subtitle">TỔNG GIÁ TRỊ</div>
                <div class="discount-badge" id="box-total">0₫</div>
                <div class="modal-order-code" id="box-code-order">Mã đơn: #...</div>

                <div class="status-badge-large bg-info" id="box-status">Đang xử lý</div>
            </div>

            <div class="detail-section">
                <div class="detail-row">
                    <span class="detail-label">
                        <i class="fas fa-user me-1"></i> Người nhận
                    </span>
                    <span class="detail-value" id="box-customer-name">---</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        <i class="fas fa-phone me-1"></i> Số điện thoại
                    </span>
                    <span class="detail-value" id="box-phone">---</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        <i class="fas fa-calendar me-1"></i> Ngày đặt
                    </span>
                    <span class="detail-value" id="box-date">--/--/----</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        <i class="fas fa-shipping-fast me-1"></i> Phí vận chuyển
                    </span>
                    <span class="detail-value text-success" id="box-shipping-fee">0₫</span>
                </div>

                <div class="order-info-section">
                    <h6><i class="fas fa-map-marker-alt me-1"></i> Địa chỉ giao hàng</h6>
                    <div class="detail-value full-width" id="box-address">---</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="toast-notification" id="toastNotification">
    <div class="toast-content">
        <div class="toast-icon" id="toastIcon"></div>
        <div class="toast-message">
            <div class="toast-title" id="toastTitle">Thông báo</div>
            <div class="toast-text" id="toastText">Nội dung thông báo</div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script>
        const API_BASE = '/Sale/DonHang/';
        const formatVND = (num) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num);

        // Show Toast Notification
        function showToast(type, title, message) {
            const toast = $('#toastNotification');
            const icon = $('#toastIcon');

            toast.removeClass('success error').addClass(type);

            if (type === 'success') {
                icon.html('<i class="fas fa-check-circle text-success"></i>');
            } else {
                icon.html('<i class="fas fa-exclamation-circle text-danger"></i>');
            }

            $('#toastTitle').text(title);
            $('#toastText').text(message);

            toast.addClass('show');

            setTimeout(() => {
                toast.removeClass('show');
            }, 3500);
        }

        // Show Modal
        function showModal() {
            $('#orderBackdrop').addClass('show');
            $('#detailOrderModal').addClass('show');
            $('body').css('overflow', 'hidden');
        }

        // Hide Modal
        function hideModal() {
            $('#orderBackdrop').removeClass('show');
            $('#detailOrderModal').removeClass('show');
            $('body').css('overflow', 'auto');
        }

        $(document).ready(function () {
            // Close modal on backdrop click
            $('#orderBackdrop').click(hideModal);
            $('#btnCloseModal').click(hideModal);

            // Close modal on ESC key
            $(document).keydown(function (e) {
                if (e.key === "Escape") {
                    hideModal();
                }
            });

            // View Order Details
            $('body').on('click', '.btn-view-order', function () {
                const d = $(this).data();

                $('#box-code-order').text('Mã đơn: #' + d.code);
                $('#box-total').text(formatVND(d.total));
                $('#box-customer-name').text(d.customer);
                $('#box-date').text(d.date);
                $('#box-address').text(d.address);
                $('#box-phone').text(d.phone);
                $('#box-shipping-fee').text(formatVND(d.fee));

                const statusBadge = $('#box-status');
                statusBadge.removeClass('bg-success bg-warning bg-danger bg-info text-dark');

                if (d.status === "Completed") {
                    statusBadge.text("Hoàn thành").addClass('bg-success');
                } else if (d.status === "ChoXacNhan") {
                    statusBadge.text("Chờ xác nhận").addClass('bg-warning text-dark');
                } else if (d.status === "Rejected" || d.status === "Đã từ chối") {
                    statusBadge.text("Đã từ chối").addClass('bg-danger');
                } else {
                    statusBadge.text(d.status).addClass('bg-info');
                }

                showModal();
            });

            // Approve Order
            $('body').on('click', '.btn-approve', function () {
                const id = $(this).data('id');
                const code = $(this).data('code');

                if (confirm("Xác nhận DUYỆT đơn hàng #" + code + "?")) {
                    $.ajax({
                        url: API_BASE + 'CapNhatTrangThai',
                        type: 'POST',
                        data: { maDonHang: id, trangThaiMoi: 'Đã duyệt' },
                        success: function (rs) {
                            if (rs.success) {
                                showToast('success', 'Thành công', 'Đơn hàng #' + code + ' đã được duyệt!');
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showToast('error', 'Lỗi', rs.msg || 'Không thể duyệt đơn hàng');
                            }
                        },
                        error: function () {
                            showToast('error', 'Lỗi', 'Không thể kết nối đến server');
                        }
                    });
                }
            });

            // Reject Order
            $('body').on('click', '.btn-reject', function () {
                const id = $(this).data('id');
                const code = $(this).data('code');

                if (confirm("Xác nhận TỪ CHỐI đơn hàng #" + code + "?")) {
                    $.ajax({
                        url: API_BASE + 'CapNhatTrangThai',
                        type: 'POST',
                        data: { maDonHang: id, trangThaiMoi: 'Đã từ chối' },
                        success: function (rs) {
                            if (rs.success) {
                                showToast('success', 'Thành công', 'Đơn hàng #' + code + ' đã bị từ chối');
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showToast('error', 'Lỗi', rs.msg || 'Không thể từ chối đơn hàng');
                            }
                        },
                        error: function () {
                            showToast('error', 'Lỗi', 'Không thể kết nối đến server');
                        }
                    });
                }
            });
        });
    </script>
}